#: import NumberItem reflex.components.widgets.number_item
#: import DualNumberItem reflex.components.widgets.dual_number_item
#: import BooleanItem reflex.components.widgets.boolean_item
#: import DropDownItem reflex.components.widgets.dropdown_item

<InputScreen>:
  BoxLayout:
    orientation: "vertical"
    padding: 10
    # Header names the axis this input feeds, so the operator does not have to
    # go to the Axes screen to find out what they are editing. Read-only; see
    # reflex/utils/input_axis_map.py.
    ScreenHeader:
      text: "Scale Input {}{}".format(root.input.inputIndex, "  →  " + root.axis_label if root.axis_label else "")

    ScrollView:
      do_scroll_x: False
      do_scroll_y: True
      GridLayout:
        id: grid_layout
        cols: 1
        spacing: 1
        size_hint_y: None
        height: self.minimum_height

        BooleanItem:
          name: "Spindle Mode"
          value: root.input.spindleMode
          help_file: "spindle_mode.md"
          on_value: root.input.spindleMode = self.value

        BooleanItem:
          name: "Reverse"
          value: root.input.reverse
          on_value: root.input.reverse = self.value

        # HOW THE SCALE IS ENTERED. "Resolution" is the number printed on the
        # scale itself (1um, 5um); "Ratio" is the stored mm-per-count pair and
        # is how a real drive ratio is named by whoever specified it. Both
        # write the same two registers -- see utils/scale_resolution.py.
        DropDownItem:
          name: "Scale entry"
          help_file: "scales.md"
          options: root.entry_modes
          value: root.entry_mode
          on_value: root.entry_mode = self.value
          opacity: 0 if root.input.spindleMode else 1
          height: 0 if root.input.spindleMode else 60
          disabled: root.input.spindleMode

        NumberItem:
          name: "Resolution (um/count)"
          value: root.get_resolution(root.input.ratioNum, root.input.ratioDen)
          help_file: "scales.md"
          on_value: root.set_resolution(self.value)
          opacity: 0 if (root.input.spindleMode or root.entry_mode != "Resolution") else 1
          height: 0 if (root.input.spindleMode or root.entry_mode != "Resolution") else 60
          disabled: root.input.spindleMode or root.entry_mode != "Resolution"

        NumberItem:
          name: "Ratio numerator (mm)"
          value: root.input.ratioNum
          integer: True
          help_file: "scales.md"
          on_value: root.input.ratioNum = int(self.value)
          opacity: 0 if (root.input.spindleMode or root.entry_mode != "Ratio") else 1
          height: 0 if (root.input.spindleMode or root.entry_mode != "Ratio") else 60
          disabled: root.input.spindleMode or root.entry_mode != "Ratio"
        NumberItem:
          name: "Ratio denominator (counts)"
          value: root.input.ratioDen
          integer: True
          help_file: "scales.md"
          on_value: root.input.ratioDen = int(self.value)
          opacity: 0 if (root.input.spindleMode or root.entry_mode != "Ratio") else 1
          height: 0 if (root.input.spindleMode or root.entry_mode != "Ratio") else 60
          disabled: root.input.spindleMode or root.entry_mode != "Ratio"

        NumberItem:
          name: "Encoder PPR"
          value: root.input.encoder_ppr
          integer: True
          help_file: "spindle_mode.md"
          on_value: root.input.encoder_ppr = int(self.value)
          opacity: 1 if root.input.spindleMode else 0
          height: 60 if root.input.spindleMode else 0
          disabled: not root.input.spindleMode
        NumberItem:
          name: "Gear Ratio Num"
          value: root.input.gear_ratio_num
          integer: True
          help_file: "spindle_mode.md"
          on_value: root.input.gear_ratio_num = int(self.value)
          opacity: 1 if root.input.spindleMode else 0
          height: 60 if root.input.spindleMode else 0
          disabled: not root.input.spindleMode
        NumberItem:
          name: "Gear Ratio Den"
          value: root.input.gear_ratio_den
          integer: True
          help_file: "spindle_mode.md"
          on_value: root.input.gear_ratio_den = int(self.value)
          opacity: 1 if root.input.spindleMode else 0
          height: 60 if root.input.spindleMode else 0
          disabled: not root.input.spindleMode
