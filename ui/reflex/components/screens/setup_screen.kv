#: import ScreenHeader reflex.components.widgets.screen_header
#: import MODE_ELS reflex.app.MODE_ELS
#: import USE_CASE_MODES reflex.app.USE_CASE_MODES

<SetupButton@Button>:
  font_name: app.theme.font_bold
  font_size: app.formats.font_size
  color: app.theme.accent_text if self.state == 'down' else app.theme.text
  background_normal: ''
  background_down: ''
  background_color: 0, 0, 0, 0
  on_press: app.beep()
  canvas.before:
    Color:
      rgba: app.theme.accent_bg if self.state == 'down' else app.theme.surface
    RoundedRectangle:
      pos: self.pos
      size: self.size
      radius: [dp(8)]
    Color:
      rgba: app.theme.accent if self.state == 'down' else app.theme.border
    Line:
      rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(8))
      width: 1.0

<SetupScreen>:
  BoxLayout:
    title: "Setup"
    orientation: "vertical"
    padding: 10
    ScreenHeader:
      text: "Setup"

    GridLayout:
      spacing: 20
      padding: 20
      cols: 4
      row_force_default: True
      row_default_height: (self.height - self.padding[1] - self.padding[3] - self.spacing[1] * 2) / 3
      SetupButton:
        text: "Machine"
        on_release: app.manager.goto("machine")
      SetupButton:
        text: "Inputs"
        on_release: app.manager.goto("inputs_setup")
      SetupButton:
        text: "Axes"
        on_release: app.manager.goto("axes_setup")
      SetupButton:
        text: "Servo"
        on_release: app.manager.goto("servo")
      SetupButton:
        text: "Network"
        on_release: app.manager.goto("network")
      SetupButton:
        text: "Formats"
        on_release: app.manager.goto("formats")
      SetupButton:
        text: "System"
        on_release: app.manager.goto("system")
      SetupButton:
        text: "Logs"
        on_release: app.manager.goto("logs")
      SetupButton:
        text: "Profiling"
        on_release: app.manager.goto("profiling")
      SetupButton:
        text: "Update"
        on_release: app.manager.goto("update")
      # ELS setup is shown only for use cases that expose ELS mode.
      SetupButton:
        text: "ELS"
        opacity: 1 if MODE_ELS in USE_CASE_MODES.get(app.use_case, []) else 0
        disabled: MODE_ELS not in USE_CASE_MODES.get(app.use_case, [])
        on_release: app.manager.goto("els_setup")
      SetupButton:
        text: "Export to USB"
        on_release: root.export_to_usb()
      SetupButton:
        text: "Import from USB"
        on_release: root.import_from_usb()

    # Opt-in GitHub gist sync. A row of its own rather than three more cells in
    # the grid above: that grid's row height is computed for three rows and is
    # already full, and these controls are one feature that reads as a unit.
    BoxLayout:
      id: gist_row
      size_hint_y: None
      height: dp(48)
      spacing: 10
      ToggleButton:
        id: gist_toggle
        text: "Sync to GitHub gist"
        font_name: app.theme.font_bold
        font_size: app.formats.font_size
        state: 'down' if root.gist_enabled else 'normal'
        on_release: root.toggle_gist_sync(self.state == 'down')
      SetupButton:
        text: "Sync now"
        disabled: not root.gist_enabled
        on_release: root.sync_now()
      SetupButton:
        text: "Restore from gist"
        on_release: root.restore_from_gist()

    # The device-flow user code, LARGE. No QR: no QR library is a dependency of
    # this app and this feature added none, so the operator reads the code and
    # the short URL. Blank (and zero-height) when no flow is in progress.
    Label:
      id: gist_code_label
      text: root.gist_code_text
      size_hint_y: None
      height: dp(64) if root.gist_code_text else 0
      opacity: 1 if root.gist_code_text else 0
      halign: "center"
      font_name: app.theme.font_bold
      font_size: app.formats.font_size * 1.8
      color: app.theme.accent

    # Where to turn the grant off again, beside the toggle that turned it on.
    Label:
      id: gist_revoke_label
      text: "Revoke access at " + root.gist_revoke_text
      size_hint_y: None
      height: dp(20)
      font_name: app.theme.font_bold
      font_size: app.formats.font_size * 0.7
      color: app.theme.text

    Label:
      id: status_label
      text: root.status_text
      size_hint_y: None
      height: dp(24)
      font_name: app.theme.font_bold
      font_size: app.formats.font_size
      color: app.theme.text
