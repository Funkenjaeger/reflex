#: import ScreenHeader reflex.components.widgets.screen_header
#: import MODE_ELS reflex.app.MODE_ELS
#: import USE_CASE_MODES reflex.app.USE_CASE_MODES

<SetupScreen>:
  BoxLayout:
    title: "Setup"
    orientation: "vertical"
    padding: 10
    ScreenHeader:
      text: "Setup"

    # Twelve buttons, three rows of four. The row height is computed for
    # exactly three rows, so a thirteenth button does not add a row -- it draws
    # outside the grid (that is how Import from USB ended up under the gist
    # controls, 2026-09-17). New entries go on a sub-screen, as Backup did.
    GridLayout:
      id: grid
      spacing: 20
      padding: 20
      cols: 4
      row_force_default: True
      row_default_height: (self.height - self.padding[1] - self.padding[3] - self.spacing[1] * 2) / 3
      SetupButton:
        text: "Machine"
        on_release: app.manager.goto("machine")
      SetupButton:
        text: "Inputs"
        on_release: app.manager.goto("inputs_setup")
      SetupButton:
        text: "Axes"
        on_release: app.manager.goto("axes_setup")
      SetupButton:
        text: "Servo"
        on_release: app.manager.goto("servo")
      SetupButton:
        text: "Network"
        on_release: app.manager.goto("network")
      SetupButton:
        text: "Formats"
        on_release: app.manager.goto("formats")
      SetupButton:
        text: "System"
        on_release: app.manager.goto("system")
      SetupButton:
        text: "Logs"
        on_release: app.manager.goto("logs")
      SetupButton:
        text: "Profiling"
        on_release: app.manager.goto("profiling")
      SetupButton:
        text: "Update"
        on_release: app.manager.goto("update")
      # ELS setup is shown only for use cases that expose ELS mode.
      SetupButton:
        text: "ELS"
        opacity: 1 if MODE_ELS in USE_CASE_MODES.get(app.use_case, []) else 0
        disabled: MODE_ELS not in USE_CASE_MODES.get(app.use_case, [])
        on_release: app.manager.goto("els_setup")
      SetupButton:
        text: "Backup"
        on_release: app.manager.goto("backup")
