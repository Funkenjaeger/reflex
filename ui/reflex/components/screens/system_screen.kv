#: import ScreenHeader reflex.components.widgets.screen_header
#: import TitleItem reflex.components.widgets.title_item
#: import StringItem reflex.components.widgets.string_item

# Read-only, and deliberately tiny. The operator UI does no system
# administration (Evan, 2026-09-19): the upstream partition-resize and reboot
# buttons and the disk/partition readout were removed; free space is the one
# figure an operator might need (the flight recorder writes to this card).
<SystemScreen>:
  BoxLayout:
    title: "System"
    orientation: "vertical"
    padding: 10
    ScreenHeader:
      text: "System"

    GridLayout:
      cols: 1
      spacing: 1
      size_hint_y: None
      height: self.minimum_height

      TitleItem:
        name: "Storage"
      StringItem:
        name: "Free space"
        disabled: True
        value: root.free_space_str
        help_file: "system_storage.md"

    Widget:
