#: import HomeToolbar reflex.components.home.home_toolbar
#: import THEME reflex.components.widgets.facelift_theme
<Label>:
  font_name: "fonts/iosevka-regular.ttf"

<Button>:
  font_name: "fonts/Manrope-Bold.ttf"

<TextInput>:
  font_name: "fonts/iosevka-regular.ttf"

<HomePage>:
  BoxLayout:
    orientation: "horizontal"

    HomeToolbar:
      id: home_toolbar

    # Divider rail: touches the sidebar tabs on the left and the content on the
    # right (mockup variant).
    Widget:
      size_hint_x: None
      width: dp(7)
      canvas:
        # Darker blueish bar...
        Color:
          rgba: THEME.RECESS_FILL
        Rectangle:
          pos: self.x, self.y
          size: self.width, self.height
        # ...with a skinny darker line on its LEFT side (against the tabs).
        Color:
          rgba: [0.20, 0.25, 0.31, 1]
        Line:
          points: (self.x + 1, self.y, self.x + 1, self.top)
          width: 1.0

    BoxLayout:
      id: bars_container
      orientation: "vertical"
      size_hint: 1, 1
