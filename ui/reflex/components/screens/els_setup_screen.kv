#: import ScreenHeader reflex.components.widgets.screen_header
#: import DropDownItem reflex.components.widgets.dropdown_item
#: import TitleItem reflex.components.widgets.title_item
#: import BooleanItem reflex.components.widgets.boolean_item

<ElsSetupScreen>:
  BoxLayout:
    orientation: "vertical"
    padding: 10
    ScreenHeader:
      text: "ELS Setup"

    ScrollView:
      do_scroll_x: False
      do_scroll_y: True
      GridLayout:
        cols: 1
        spacing: 1
        size_hint_y: None
        height: self.minimum_height

        TitleItem:
          name: "Axis Roles"
        DropDownItem:
          id: spindle_dropdown
          name: "Spindle Axis"
          help_file: "els_axis_roles.md"
          on_value: root.on_spindle_selected(self, self.value)
        DropDownItem:
          id: z_dropdown
          name: "Saddle Axis (Z)"
          help_file: "els_axis_roles.md"
          on_value: root.on_z_selected(self, self.value)
        DropDownItem:
          id: x_dropdown
          name: "Cross Slide Axis (X)"
          help_file: "els_axis_roles.md"
          on_value: root.on_x_selected(self, self.value)
        # THE ONLY PLACE THIS IS EDITABLE. Radius/diameter is a property of the
        # cross-slide ROLE, not of axes in general -- offering it on Z or the
        # spindle would be a trap -- so it lives directly under the dropdown
        # that nominates X rather than on the axis screen. Collapses when no X
        # is assigned: there is nothing for it to describe.
        BooleanItem:
          id: x_diameter_toggle
          name: "X reads diameter"
          help_file: "els_radius_diameter.md"
          value: root.x_diameter_mode
          on_value: root.on_x_diameter_selected(self, self.value)
          opacity: 1 if root.has_x_axis else 0
          height: 60 if root.has_x_axis else 0
          disabled: not root.has_x_axis
