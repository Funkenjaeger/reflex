#: import ScreenHeader reflex.components.widgets.screen_header
#: import TitleItem reflex.components.widgets.title_item
#: import StringItem reflex.components.widgets.string_item
#: import BooleanItem reflex.components.widgets.boolean_item
#: import DropDownItem reflex.components.widgets.dropdown_item
#: import ButtonItem reflex.components.widgets.button_item
#: import SsidPopup reflex.components.popups.ssid_popup

<NetworkScreen>:
  BoxLayout:
    title: "Network settings"
    orientation: "vertical"
    padding: 10
    ScreenHeader:
      text: "Network settings"

    ScrollView:
      do_scroll_x: False
      do_scroll_y: True
      GridLayout:
        id: grid_layout
        cols: 1
        spacing: 1
        size_hint_y: None

        TitleItem:
          name: "Network interface"
        BooleanItem:
          name: "Enable Wifi"
          value: root.wifi_enabled
          help_file: "enable_wifi.md"
          on_value: root.wifi_enabled = self.value
        DropDownItem:
          name: "Network interface"
          options: root.devices
          help_file: "network_connection.md"
          value: root.devices[0] if len(root.devices) > 0 else ""
        StringItem:
          name: "Hardware address"
          disabled: True
          help_file: "network_connection.md"
          value: root.hwaddr
        StringItem:
          name: "State"
          disabled: True
          help_file: "network_connection.md"
          value: root.state

        TitleItem:
          name: "Connection properties"
        ButtonItem:
          name: "Network"
          value: root.connection if root.connection is not None else ""
          disabled: root.lock
          help_file: "network_connection.md"
          on_release: Factory.SsidPopup(callback=root.select_network, selected_network=root.connection).open()
        StringItem:
          name: "Wifi password"
          value: root.password
          disabled: root.lock
          help_file: "network_connection.md"
          on_value: root.password = self.value
        ButtonItem:
          name: "Apply configuration"
          value: "Apply"
          disabled: root.lock
          help_file: "network_connection.md"
          on_release: root.apply()

        TitleItem:
          name: "IP properties"
        StringItem:
          name: "IP address"
          value: root.address
          disabled: True
          on_value: root.address = self.value
        StringItem:
          name: "DNS server"
          value: root.dns
          disabled: True
          on_value: root.dns = self.value
        StringItem:
          name: "Default gateway"
          value: root.gateway
          disabled: True
          on_value: root.gateway = self.value

        TitleItem:
          name: "Error reporting"
        BooleanItem:
          name: "Error reporting"
          value: not app.formats.disable_error_reporting
          help_file: "error_reporting.md"
          on_value: app.formats.disable_error_reporting = not self.value

        TitleItem:
          name: "Status"
        FormOutputText:
          size_hint_y: None
          height: 160
          text: root.status_text
