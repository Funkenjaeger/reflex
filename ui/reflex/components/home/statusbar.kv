#: import LedButton reflex.components.toolbars.led_button
#: import THEME reflex.components.widgets.facelift_theme

<StatusBar>:
  size_hint: 1, None
  height: 38
  orientation: "horizontal"
  padding: dp(8), dp(4), dp(8), dp(4)
  spacing: dp(6)

  # ── Telemetry gutter: its own recessed, rounded box; the four items ride
  #    inside it (flat: True) instead of drawing their own pills. ──
  BoxLayout:
    orientation: "horizontal"
    padding: dp(4), 0
    spacing: dp(4)
    canvas.before:
      Color:
        rgba: THEME.RECESS_FILL
      RoundedRectangle:
        pos: self.pos
        size: self.size
        radius: [dp(7)]
      Color:
        rgba: THEME.BORDER_DIM
      Line:
        rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(7))
        width: 1.0

    LedButton:
      flat: True
      font_name: THEME.FONT_MONO
      label: "COM"
      checkbox_value: app.board.connected or app.board.blink

    LedButton:
      flat: True
      font_name: THEME.FONT_MONO
      label: "{:0.0f}".format(0 if root.interval == 0 else (100000000 / root.interval))

    LedButton:
      flat: True
      font_name: THEME.FONT_MONO
      label: "{:0.0f}".format(root.fps)

    LedButton:
      flat: True
      font_name: THEME.FONT_MONO
      label: "{:0.0f}".format(root.cycles)

  # ── Reflex logo + version: their own recessed box at the right end, with the
  #    logo filling the box height (per the mockup). ──
  # Dogleg box: the version sits up in the short LEFT part (over the tall DRO
  # digits); the larger logo sits in the RIGHT part, which drops down (dp(20))
  # into the dead space above the shorter units/Zero. Drawn from the status bar
  # but extends below it -- the DRO leaves that area transparent so it shows.
  FloatLayout:
    size_hint_x: None
    width: dp(272)
    # jog_x: where the box steps down; kept right of the DRO value background so
    # it doesn't get clipped by the last digit (which read as a double dogleg).
    canvas.before:
      Color:
        rgba: THEME.RECESS_FILL
      Rectangle:
        pos: self.x, self.y
        size: dp(92), self.height
      Rectangle:
        pos: self.x + dp(92), self.y - dp(20)
        size: self.width - dp(92), self.height + dp(20)
      Color:
        rgba: THEME.BORDER_DIM
      Line:
        points: (self.x, self.top, self.right, self.top, self.right, self.y - dp(20), self.x + dp(92), self.y - dp(20), self.x + dp(92), self.y, self.x, self.y, self.x, self.top)
        width: 1.0

    Label:
      text: app.version
      font_name: THEME.FONT_MONO
      font_size: 13
      color: THEME.TEXT_DIM
      size_hint: None, None
      size: dp(92), self.parent.height
      pos: self.parent.x, self.parent.y
      halign: 'center'
      valign: 'middle'
      text_size: self.size

    Image:
      source: "pictures/reflex_logo.png"
      mipmap: True
      size_hint: None, None
      height: dp(46)
      width: self.height * 3.83
      pos: self.parent.right - self.width - dp(8), self.parent.y - dp(14)
      allow_stretch: True
      keep_ratio: True
