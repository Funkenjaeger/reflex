#: import Factory kivy.factory.Factory
#: import Keypad reflex.components.popups.keypad
#: import AutoSizeButton reflex.components.widgets.auto_size_button
#: import CircularButton reflex.components.widgets.circular_button

<CoordBar>:
  orientation: "horizontal"
  size_hint_y: 1
  # Axis label: a cell in the dark left gutter (right border + bottom divider so
  # the rows merge into one gutter). Still toggles sync; a green letter + faint
  # green fill tint signals sync enabled.
  Button:
    width: 96
    size_hint_x: None
    text: root.axis.axis_name if root.axis else "?"
    font_name: app.theme.font_bold
    font_size: min(self.height / 1.7, self.width / 1.7)
    color: app.theme.success if (root.axis and root.axis.syncEnable) else app.theme.text
    background_color: 0, 0, 0, 0
    background_normal: ""
    on_press: app.beep()
    on_release: root.toggle_sync()
    canvas.before:
      # Raised axis button: drop shadow, then a stencil-clipped planar gradient
      # face (success tint when synced), a top highlight line and a full border
      # -- so Z/X lift off the surface like the mockup, instead of reading as a
      # flat gutter cell.
      Color:
        rgba: app.theme.shadow
      RoundedRectangle:
        pos: self.x + dp(4), self.y + dp(6) - dp(2)
        size: self.width - dp(8), self.height - dp(12)
        radius: [dp(8)]
      StencilPush
      RoundedRectangle:
        pos: self.x + dp(4), self.y + dp(6)
        size: self.width - dp(8), self.height - dp(12)
        radius: [dp(8)]
      StencilUse
      Color:
        rgba: app.theme.success_bg if (root.axis and root.axis.syncEnable) else [1, 1, 1, 1]
      Rectangle:
        texture: None if (root.axis and root.axis.syncEnable) else app.theme.surface_texture
        pos: self.x + dp(4), self.y + dp(6)
        size: self.width - dp(8), self.height - dp(12)
      StencilUnUse
      RoundedRectangle:
        pos: self.x + dp(4), self.y + dp(6)
        size: self.width - dp(8), self.height - dp(12)
        radius: [dp(8)]
      StencilPop
      Color:
        rgba: app.theme.surface_sheen if not (root.axis and root.axis.syncEnable) else [0, 0, 0, 0]
      Line:
        points: (self.x + dp(12), self.top - dp(6) - 1, self.right - dp(12), self.top - dp(6) - 1)
        width: 1.0
      Color:
        rgba: app.theme.success if (root.axis and root.axis.syncEnable) else app.theme.border
      Line:
        rounded_rectangle: (self.x + dp(4), self.y + dp(6), self.width - dp(8), self.height - dp(12), dp(8))
        width: 1.2

  BoxLayout:
    orientation: "horizontal"
    BoxLayout:
      size_hint_x: 0.5
      orientation: "vertical"
      BoxLayout:
        orientation: "horizontal"
        size_hint_y: 0.7
        AutoSizeButton:
          background_color: 0, 0, 0, 0
          id: pos_label
          font_name: app.theme.font_seg
          max_font_size: min(self.height / 1.1, self.parent.width/5)
          font_style: "bold"
          # This button renders the dim "all segments on" ghost; the live value
          # is overlaid by the child Label below so unlit segments show through
          # faintly (authentic 7-seg LCD). Auto-sizing on the all-8s ghost keeps
          # the digit size stable as the value changes (DSEG7 is monospaced).
          # readout_ghost is theme-aware so the ghost reads on light AND dark.
          color: app.theme.readout_ghost
          # Strip the leading "+": DSEG7Classic has no "+" glyph (renders tofu);
          # negatives keep their "-". The ghost masks digits to 8 after that.
          text: root.all_segments((root.axis.formattedPosition).replace("+", "")) if root.axis else "--"
          text_size: self.size
          halign: 'right'
          valign: 'center'
          on_release: root.update_position()
          Label:
            # Live value, overlaid on the ghost at full brightness; shares the
            # button's geometry and fitted font size so the digits line up.
            # pos_label is a Button (not a layout), so bind geometry explicitly
            # rather than rely on size_hint/pos_hint (which a layout would honor).
            font_name: app.theme.font_seg
            font_size: pos_label.font_size
            bold: True
            color: app.formats.display_color
            text: (root.axis.formattedPosition).replace("+", "") if root.axis else "--"
            size_hint: None, None
            size: pos_label.size
            pos: pos_label.pos
            text_size: self.size
            halign: 'right'
            valign: 'center'
        Label:
          size_hint_x: None
          width: self.texture_size[0] + 4
          font_name: app.formats.font_name
          font_size: pos_label.font_size / 4
          color: app.formats.display_color
          text: root.axis.position_unit if root.axis else ""
          valign: 'center'
      BoxLayout:
        orientation: "horizontal"

        # Hide speed display if show_speeds is False
        size_hint_y: 0.3 if app.formats.show_speeds else None
        height: self.height if app.formats.show_speeds else 0
        opacity: 1 if app.formats.show_speeds else 0
        disabled: not app.formats.show_speeds

        Label:
          font_name: app.formats.font_name
          font_size: self.height / 1.5
          font_style: "bold"
          color: app.formats.display_color
          text: root.axis.formattedSpeed if root.axis else "--"
          text_size: self.size
          halign: 'right'
          valign: 'top'
        Label:
          size_hint_x: None
          width: self.texture_size[0] + 4
          font_name: app.formats.font_name
          font_size: self.height / 1.5 / 4
          color: app.formats.display_color
          text: root.axis.speed_unit if root.axis else ""
          valign: 'top'

    BoxLayout:
      size_hint_x: None
      width: 80
      orientation: 'vertical'
      Label:
        text: "Num"
        font_size: self.height / 1.5
        size_hint_y: 0.3
        color: app.formats.display_color
        halign: 'center'
        valign: 'top'
      Button:
        size_hint_y: 0.7
        font_name: app.formats.font_name
        font_size: self.width / 3
        font_style: "bold"
        background_color: app.theme.surface
        color: app.formats.display_color
        text: str(int(root.axis.syncRatioNum)) if root.axis else "--"
        text_size: self.size
        halign: 'center'
        valign: 'middle'
        on_press: app.beep()
        on_release: Factory.Keypad(integer=True).show(root.axis, 'syncRatioNum') if root.axis else None

    BoxLayout:
      size_hint_x: None
      width: 80
      orientation: 'vertical'
      Label:
        text: "Den"
        font_size: self.height / 1.5
        size_hint_y: 0.3
        color: app.formats.display_color
        halign: 'center'
        valign: 'top'
      Button:
        size_hint_y: 0.7
        font_name: app.formats.font_name
        font_size: self.width / 3
        font_style: "bold"
        background_color: app.theme.surface
        color: app.formats.display_color
        text: str(int(root.axis.syncRatioDen)) if root.axis else "--"
        text_size: self.size
        halign: 'center'
        valign: 'middle'
        on_press: app.beep()
        on_release: Factory.Keypad(integer=True).show(root.axis, 'syncRatioDen') if root.axis else None

  # Zero key: a small centered circle (not a full-height disc) with margin to
  # the screen edge, matching the mockup.
  AnchorLayout:
    size_hint_x: None
    width: dp(108)
    anchor_x: 'center'
    anchor_y: 'center'
    CircularButton:
      text: "Zero"
      size_hint: None, None
      height: min(self.parent.height * 0.62, dp(76))
      width: self.height
      font_size: self.height * 0.30
      # beep handled by BeepMixin.on_press
      on_press: root.on_zero_press()
      on_release: root.on_zero_release()
