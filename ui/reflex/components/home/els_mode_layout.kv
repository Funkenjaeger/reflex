#: import THEME reflex.components.widgets.facelift_theme
#: import AutoSizeButton reflex.components.widgets.auto_size_button

<ElsSpindleInfo>:
  orientation: "horizontal"

  # Spindle direction icon: a cell in the dark left gutter (right border +
  # bottom divider) so it lines up with the axis-label rows above it.
  Button:
    width: 96
    size_hint_x: None
    font_name: "fonts/Font Awesome 6 Free-Solid-900.otf"
    font_size: min(self.height / 2, self.width / 2)
    background_color: 0, 0, 0, 0
    background_normal: ""
    color: app.formats.display_color
    text: root.direction_icon
    canvas.before:
      Color:
        rgba: THEME.SLATE_FILL
      Rectangle:
        pos: self.pos
        size: self.size
      Color:
        rgba: THEME.BORDER_DIM
      Line:
        points: (self.right - 0.5, self.top, self.right - 0.5, self.y, self.x, self.y)
        width: 1.0

  # Main content: RPM value (large) + "RPM" unit label (small), matching axis bar pattern
  BoxLayout:
    orientation: "horizontal"
    Label:
      id: rpm_label
      font_name: THEME.FONT_SEG
      font_size: min(self.height / 1.1, self.width / 5)
      font_style: "bold"
      color: app.formats.display_color
      text: root.spindle_rpm.replace("+", "")
      text_size: self.size
      halign: 'right'
      valign: 'center'
    Label:
      size_hint_x: None
      width: self.texture_size[0] + 4
      font_name: app.formats.font_name
      font_size: rpm_label.font_size / 4
      color: app.formats.display_color
      text: "RPM"
      valign: 'center'

  # Match the DRO rows' right margin (Zero + spacer) so RPM stays aligned.
  Widget:
    size_hint_x: None
    width: dp(157)
