#: import AutoSizeButton reflex.components.widgets.auto_size_button
#: import all_segments reflex.components.home.coordbar.all_segments

<ElsSpindleInfo>:
  orientation: "horizontal"

  # Spindle direction icon: a cell in the dark left gutter (right border +
  # bottom divider) so it lines up with the axis-label rows above it.
  Button:
    width: 96
    size_hint_x: None
    font_name: app.theme.font_icon
    font_size: min(self.height / 2, self.width / 2)
    background_color: 0, 0, 0, 0
    background_normal: ""
    color: app.formats.display_color
    text: root.direction_icon
    canvas.before:
      Color:
        rgba: app.theme.surface
      Rectangle:
        pos: self.pos
        size: self.size
      Color:
        rgba: app.theme.border_dim
      Line:
        points: (self.right - 0.5, self.top, self.right - 0.5, self.y, self.x, self.y)
        width: 1.0

  # Main content: RPM value (large) + "RPM" unit label (small), matching axis bar pattern
  BoxLayout:
    orientation: "horizontal"
    Label:
      id: rpm_label
      font_name: app.theme.font_seg
      font_size: min(self.height / 1.1, self.width / 5)
      font_style: "bold"
      # Dim all-segments ghost; the live RPM overlays it (see DRO rows).
      color: app.theme.readout_ghost
      text: all_segments(root.display_rpm)
      text_size: self.size
      halign: 'right'
      valign: 'center'
      Label:
        # Overlay the live value on the ghost. rpm_label is a plain Label (not
        # a layout), so it won't position a child via size_hint/pos_hint --
        # bind geometry to the parent explicitly or the value floats to (0,0).
        font_name: app.theme.font_seg
        font_size: rpm_label.font_size
        bold: True
        color: app.formats.display_color
        text: root.display_rpm
        size_hint: None, None
        size: rpm_label.size
        pos: rpm_label.pos
        text_size: self.size
        halign: 'right'
        valign: 'center'
    Label:
      size_hint_x: None
      width: self.texture_size[0] + 4
      font_name: app.formats.font_name
      font_size: rpm_label.font_size / 4
      color: app.formats.display_color
      text: "RPM"
      valign: 'center'

  # Match the DRO rows' right margin (Zero + spacer) so RPM stays aligned.
  Widget:
    size_hint_x: None
    width: dp(157)
