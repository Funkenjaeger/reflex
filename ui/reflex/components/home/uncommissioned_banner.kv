<UncommissionedBanner>:
  # THE BINDING THAT MAKES THIS A STATE AND NOT A DECORATION. `uncommissioned`
  # is set by MainApp.latch_commissioning_state() before any widget exists, so
  # this rule evaluates once, on the way up. It moves exactly once afterwards,
  # and only ever True -> False: UncommissionedBanner._gate_opened() writes it
  # when the operator confirms dismissal in the modal, which is the same event
  # that opens the write gate.
  active: app.uncommissioned

  # ONE ROW. `horizontal` is the change of 2026-09-22 -- see the class
  # docstring on why the elaboration and the remedy moved into the modal.
  orientation: "horizontal"
  size_hint_x: 1
  # height / opacity / disabled are NOT here on purpose: they are decided in
  # UncommissionedBanner._apply_active() so that a test can actually run the
  # collapse. See the class docstring -- a kv expression can only be checked as
  # text under this repo's mock GL backend, and "does the banner disappear on a
  # commissioned machine" is too load-bearing for a text match.
  padding: dp(9), dp(2)
  spacing: dp(8)

  canvas.before:
    # Amber, the same `warning` token the operator already reads as "caution"
    # on the notice strip, and OPAQUE -- this covers nothing, it IS the top of
    # the screen, and a translucent fill over the background gradient would
    # wash out at exactly the brightness a machine shop is lit at.
    Color:
      rgba: app.theme.warning if root.active else (0, 0, 0, 0)
    RoundedRectangle:
      pos: self.pos
      size: self.size
      radius: [dp(6)]

  Label:
    # SEVERITY IS NOT CARRIED BY COLOUR ALONE (statusbar.kv, same reasoning):
    # circle-exclamation says it too, for a dirty screen or low light.
    #
    # THE GLYPH WAS MISSING UNTIL 2026-09-22: this line read `text: ""` from
    # the day the file was written, so the comment above described an icon
    # that was never on the screen and the strip carried severity by colour
    # alone -- the exact thing it says it does not do.  is the same
    # codepoint statusbar.kv uses for its warning notice; written escaped,
    # which is the other spelling already in this repo (plot_toolbar.kv), so
    # an editor cannot silently eat it the way a raw private-use byte can.
    text: ""
    font_name: app.theme.font_icon
    font_size: dp(16)
    color: app.theme.background
    size_hint_x: None
    width: dp(20)
    halign: 'center'
    valign: 'middle'
    text_size: self.size

  Label:
    id: label_headline
    text: root.headline
    font_name: app.theme.font_bold
    font_size: dp(16)
    color: app.theme.background
    size_hint_x: None
    width: self.texture_size[0]
    halign: 'left'
    valign: 'middle'
    text_size: None, self.height

  Label:
    id: label_detail
    text: root.detail
    font_name: app.theme.font_bold
    font_size: dp(13)
    color: app.theme.background
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    # Ellipsis rather than wrap: the strip is one line by construction now, so
    # a second line would be silently clipped. This row is the only one that
    # may be shortened -- the headline carries the state at its natural width
    # and the hint at its own, so neither the state nor the way to act on it
    # can be the thing that gets elided on a narrow screen.
    shorten: True
    shorten_from: 'right'

  Label:
    id: label_hint
    text: root.hint
    font_name: app.theme.font_mono
    font_size: dp(12)
    color: app.theme.background
    size_hint_x: None
    width: self.texture_size[0]
    halign: 'right'
    valign: 'middle'
    text_size: None, self.height
