<ElsSettingsPopup>:
    title: "Advanced ELS Settings"
    size_hint_x: 0.8
    size_hint_y: None
    height: 450
    auto_dismiss: True

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        GridLayout:
            id: grid_layout
            cols: 1
            spacing: 1
            size_hint_y: None
            height: self.minimum_height

            DropDownItem:
                id: thread_type_dropdown
                height: 60
                name: "Thread Type"
                help_file: "els_thread_pitch.md"
                options: root.get_thread_types()
                value: root.bar.thread_profile_type
                on_value: root.on_thread_type_selected(self.value)

            BooleanItem:
                name: "Inner Thread"
                help_file: "els_inner_thread.md"
                value: root.bar.inner_thread
                on_value: root.bar.inner_thread = self.value

            # Only meaningful in stop + retract: wizard always collects a
            # diameter, and stop-only has no Retract to gate. Left ON by
            # default -- the gate it enables is the only thing standing between
            # Retract and a tool dragged back through the thread.
            BooleanItem:
                name: "Safe diameter"
                help_file: "els_safe_diameter.md"
                value: root.bar.enable_safe_dia
                on_value: root.bar.enable_safe_dia = self.value

            NumberItem:
                name: "Backlash take-up (mm)"
                help_file: "els_backlash_takeup.md"
                value: root.backlash_mm
                on_value: root.backlash_mm = self.value

            NumberItem:
                name: "Cal sweep limit (mm)"
                help_file: "els_backlash_cal.md"
                value: root.cal_ceiling_mm
                on_value: root.cal_ceiling_mm = self.value

            NumberItem:
                name: "Cal motion threshold (Z counts)"
                help_file: "els_backlash_cal.md"
                value: root.cal_motion_thresh_counts
                on_value: root.cal_motion_thresh_counts = self.value

            ButtonItem:
                name: "Measure backlash"
                value: "Calibrate"
                help_file: "els_backlash_cal.md"
                on_release: root.open_backlash_calibration()

            ButtonItem:
                name: "Pick up existing thread"
                value: "Sync"
                help_file: "els_thread_resync.md"
                on_release: root.open_thread_resync()

            ButtonItem:
                name: "Thread phase offset"
                value: "Offset"
                help_file: "els_phase_offset.md"
                on_release: root.open_phase_offset()

            DropDownItem:
                id: reframe_notify_dropdown
                height: 60
                name: "Stop re-reference"
                help_file: "els_stop_reref.md"
                options: ["silent", "warn", "confirm"]
                value: app.els.stop_z_reframe_notify
                on_value: app.els.stop_z_reframe_notify = self.value

            # ── Advanced: stop-overshoot correction (opt-in, default OFF) ──
            TitleItem:
                name: "Advanced"

            BooleanItem:
                name: "Stop overshoot correction"
                help_file: "els_overshoot_correction.md"
                value: app.els.els_overshoot_correction
                on_value: app.els.els_overshoot_correction = self.value

            NumberItem:
                name: "Overshoot margin (Z counts)"
                help_file: "els_overshoot_correction.md"
                value: root.overshoot_margin_counts
                on_value: root.overshoot_margin_counts = self.value

            # This machine's table: measured here, stored as a machine setting
            # (reflex/fsms/els_overshoot_table.py). Empty by default.
            ButtonItem:
                name: "Overshoot table"
                value: "Measure"
                help_file: "els_overshoot_measure.md"
                on_release: root.open_overshoot_survey()

            # ── Gearbox and the coupling check (default: log only) ──
            # The table: empty for no gearbox (the default), else
            # name=factor entries, reference first (reflex/fsms/els_gear.py).
            StringItem:
                name: "Gearbox table"
                help_file: "els_gearbox.md"
                value: app.servo.gearbox_table
                on_value: root.commit_gear_table(self)

            # The owner's own position names. Absent with no gearbox: the
            # row collapses to nothing rather than offering a position.
            DropDownItem:
                height: 60 if root.has_gearbox else 0
                opacity: 1 if root.has_gearbox else 0
                disabled: not root.has_gearbox
                name: "Gearbox position"
                help_file: "els_gearbox.md"
                options: root.gear_names
                value: app.servo.gearbox_engaged
                on_value: root.select_gear(self)

            BooleanItem:
                name: "Coupling check acts (off = log only)"
                help_file: "els_gearbox.md"
                value: app.els.els_ratio_check
                on_value: app.els.els_ratio_check = self.value
