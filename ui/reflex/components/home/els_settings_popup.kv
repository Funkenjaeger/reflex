<ElsSettingsPopup>:
    title: "ELS Threading Settings"
    size_hint_x: 0.8
    size_hint_y: None
    height: 450
    auto_dismiss: True

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True
        GridLayout:
            id: grid_layout
            cols: 1
            spacing: 1
            size_hint_y: None
            height: self.minimum_height

            DropDownItem:
                id: thread_type_dropdown
                height: 60
                name: "Thread Type"
                help_file: "els_thread_pitch.md"
                options: root.get_thread_types()
                value: root.bar.thread_profile_type
                on_value: root.on_thread_type_selected(self.value)

            BooleanItem:
                name: "Inner Thread"
                help_file: "els_inner_thread.md"
                value: root.bar.inner_thread
                on_value: root.bar.inner_thread = self.value

            NumberItem:
                name: "Backlash takeup (mm)"
                help_file: "els_backlash_takeup.md"
                value: root.backlash_mm
                on_value: root.backlash_mm = self.value

            ButtonItem:
                name: "Measure backlash"
                value: "Calibrate"
                help_file: "els_backlash_cal.md"
                on_release: root.open_backlash_calibration()

            DropDownItem:
                id: reframe_notify_dropdown
                height: 60
                name: "Stop re-reference"
                help_file: "els_stop_reref.md"
                options: ["silent", "warn", "confirm"]
                value: app.els.stop_z_reframe_notify
                on_value: app.els.stop_z_reframe_notify = self.value
