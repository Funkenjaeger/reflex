#: import Factory kivy.factory.Factory
#: import Keypad reflex.components.popups.keypad
#: import FeedsTablePopup reflex.components.popups.feeds_table_popup
#: import AutoSizeButton reflex.components.widgets.auto_size_button
#: import TwoStateButton reflex.components.toolbars.two_state_button
#: import THEME reflex.components.widgets.facelift_theme
#: import TabSelector reflex.components.widgets.tab_selector
#: import IconButton reflex.components.widgets.icon_button

<ElsBar>:
  orientation: "horizontal"
  size_hint_y: None
  height: 128
  
  # ── Sync Enable: slate card, cyan status LED top-left when servo enabled ──
  FloatLayout:
    size_hint_x: None
    width: 96
    Button:
      # Fill the FloatLayout; without an explicit pos_hint a FloatLayout child
      # keeps absolute pos (0,0) and its canvas would draw in the window corner.
      size_hint: 1, 1
      pos_hint: {'x': 0, 'y': 0}
      background_color: 0, 0, 0, 0
      background_normal: ""
      on_press: app.beep()
      on_release: app.servo.toggle_enable()
      canvas.before:
        Color:
          rgba: THEME.SLATE_FILL
        RoundedRectangle:
          pos: self.x + dp(4), self.y + dp(6)
          size: self.width - dp(8), self.height - dp(12)
          radius: [dp(7)]
        Color:
          rgba: THEME.ACCENT if app.servo.servoMode else THEME.BORDER_DIM
        Line:
          rounded_rectangle: (self.x + dp(4), self.y + dp(6), self.width - dp(8), self.height - dp(12), dp(7))
          width: 1.2
        # Status LED, top-left corner.
        Color:
          rgba: THEME.ACCENT if app.servo.servoMode else THEME.BORDER_DIM
        Ellipse:
          pos: self.x + dp(12), self.top - dp(18)
          size: dp(8), dp(8)
    Image:
      source: "pictures/motor_gears.png"
      allow_stretch: True
      keep_ratio: True
      size_hint: 0.52, 0.42
      pos_hint: {'center_x': 0.5, 'center_y': 0.58}
    Label:
      text: "Sync\nEnable"
      font_name: THEME.FONT_BOLD
      font_size: dp(12)
      color: THEME.TEXT if app.servo.servoMode else THEME.TEXT_DIM
      halign: 'center'
      valign: 'middle'
      size_hint: 1, 0.3
      pos_hint: {'center_x': 0.5, 'y': 0.06}
      text_size: self.width, None

  # ── DIR: bordered box — "DIR" header (divider below) over a forward/
  #    reverse one-hot, matching the mockup; margin around the box ──
  BoxLayout:
    orientation: 'vertical'
    size_hint_x: None
    width: 96
    padding: dp(4), dp(6), dp(4), dp(6)
    BoxLayout:
      orientation: 'vertical'
      canvas.after:
        Color:
          rgba: THEME.BORDER
        Line:
          rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(7))
          width: 1.0
      Label:
        id: dir_lbl
        text: "DIR"
        size_hint_y: 0.36
        font_name: THEME.FONT_BOLD
        font_size: self.height / 1.7
        color: THEME.TEXT_DIM
        halign: 'center'
        valign: 'middle'
        canvas.after:
          Color:
            rgba: THEME.BORDER_DIM
          Line:
            points: (self.x, self.y, self.right, self.y)
            width: 1.0
      TabSelector:
        orientation: "horizontal"
        size_hint_y: 0.64
        disabled: app.els.spindle_is_running
        selected: "fwd" if root.els_forward else "rev"
        on_select: root.els_forward = (args[1] == "fwd")
        TabSegment:
          value: "fwd"
          text: "\uf060"
          font_name: "fonts/Font Awesome 6 Free-Solid-900.otf"
          show_accent: False
          round_corners: False
        TabSegment:
          value: "rev"
          text: "\uf061"
          font_name: "fonts/Font Awesome 6 Free-Solid-900.otf"
          show_accent: False
          round_corners: False

  # ── ADV: slate card; lights cyan (fill + LED) when advanced mode is on ──
  FloatLayout:
    size_hint_x: None
    width: 96
    Button:
      size_hint: 1, 1
      pos_hint: {'x': 0, 'y': 0}
      background_color: 0, 0, 0, 0
      background_normal: ""
      on_press:
        root.enable_advanced = not root.enable_advanced
        app.beep()
      canvas.before:
        Color:
          rgba: THEME.ACCENT_BG if root.enable_advanced else THEME.SLATE_FILL
        RoundedRectangle:
          pos: self.x + dp(4), self.y + dp(6)
          size: self.width - dp(8), self.height - dp(12)
          radius: [dp(7)]
        Color:
          rgba: THEME.ACCENT if root.enable_advanced else THEME.BORDER_DIM
        Line:
          rounded_rectangle: (self.x + dp(4), self.y + dp(6), self.width - dp(8), self.height - dp(12), dp(7))
          width: 1.2
        Color:
          rgba: THEME.ACCENT if root.enable_advanced else THEME.BORDER_DIM
        Ellipse:
          pos: self.x + dp(12), self.top - dp(18)
          size: dp(8), dp(8)
    Label:
      text: "ADV"
      font_name: THEME.FONT_BOLD
      font_size: dp(20)
      color: THEME.ACCENT_TEXT if root.enable_advanced else THEME.TEXT
      halign: 'center'
      valign: 'middle'
      size_hint: 1, 1
      pos_hint: {'x': 0, 'y': 0}
      text_size: self.size

  # ── Cut type / direction illustration: dark recessed panel (item 5) ──
  Button:
    background_color: 0, 0, 0, 0
    background_normal: ""
    canvas.before:
      Color:
        rgba: THEME.RECESS_FILL
      RoundedRectangle:
        pos: self.x + dp(4), self.y + dp(4)
        size: self.width - dp(8), self.height - dp(8)
        radius: [dp(7)]
      Color:
        rgba: THEME.BORDER_DIM
      Line:
        rounded_rectangle: (self.x + dp(4), self.y + dp(4), self.width - dp(8), self.height - dp(8), dp(7))
        width: 1.0
    Image:
      source: "pictures/" + root.move_type + ".png"
      x: self.parent.x + self.parent.width * 0.1
      y: self.parent.y + self.parent.height * 0.1
      width: self.parent.width * 0.8
      height: self.parent.height * 0.8
      allow_stretch: True
      keep_ratio: True

  # ── Feed / Thread: ONE control. The FEED/THREAD indicator + pitch open
  #    the feeds dialog (which DRIVES the selection); ▲▼ step the table. ──
  BoxLayout:
    orientation: 'horizontal'
    size_hint_x: None
    width: dp(168)
    padding: dp(4), dp(6), dp(4), dp(6)
    spacing: dp(5)
    FloatLayout:
      Button:
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}
        background_color: 0, 0, 0, 0
        background_normal: ""
        on_press: app.beep()
        on_release: Factory.FeedsTablePopup().show_with_callback(root.set_feed_ratio, current_mode=root.mode_name)
        canvas.before:
          Color:
            rgba: THEME.RECESS_FILL
          RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(6)]
          Color:
            rgba: THEME.BORDER_DIM
          Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(6))
            width: 1.0
      BoxLayout:
        orientation: 'vertical'
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}
        padding: dp(6), dp(6)
        spacing: dp(2)
        # FEED / THREAD indicator (read-only; the modal dialog drives it)
        BoxLayout:
          orientation: 'horizontal'
          size_hint_y: 0.4
          Label:
            text: "FEED"
            font_name: THEME.FONT_BOLD
            bold: True
            color: THEME.TEXT_DIM if ("Thread" in root.mode_name) else THEME.ACCENT_TEXT
            font_size: sp(11) if ("Thread" in root.mode_name) else sp(14)
            halign: 'center'
            valign: 'middle'
            text_size: self.size
          Label:
            text: "THREAD"
            font_name: THEME.FONT_BOLD
            bold: True
            color: THEME.ACCENT_TEXT if ("Thread" in root.mode_name) else THEME.TEXT_DIM
            font_size: sp(14) if ("Thread" in root.mode_name) else sp(11)
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        Label:
          size_hint_y: 0.6
          text: root.feed_name + " " + ("tpi" if root.mode_name == "Thread IN" else ("in" if root.mode_name == "Feed IN" else "mm"))
          font_name: THEME.FONT_MONO
          font_size: min(self.height * 0.5, self.width * 0.17)
          color: app.formats.display_color
          halign: 'center'
          valign: 'middle'
          text_size: self.size
    BoxLayout:
      orientation: 'vertical'
      size_hint_x: None
      width: dp(38)
      spacing: dp(5)
      IconButton:
        radius: 6
        icon: "\uf062"
        on_release: root.next_feed()
      IconButton:
        radius: 6
        icon: "\uf063"
        on_release: root.previous_feed()
