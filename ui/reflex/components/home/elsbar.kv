#: import Factory kivy.factory.Factory
#: import Keypad reflex.components.popups.keypad
#: import FeedsTablePopup reflex.components.popups.feeds_table_popup
#: import AutoSizeButton reflex.components.widgets.auto_size_button
#: import TwoStateButton reflex.components.toolbars.two_state_button
#: import TabSelector reflex.components.widgets.tab_selector
#: import IconButton reflex.components.widgets.icon_button
#: import LedCardButton reflex.components.widgets.led_card_button

<ElsBar>:
  orientation: "horizontal"
  size_hint_y: None
  height: 128
  
  # ── Sync Enable: shared LED card (cyan when servo enabled) ──
  LedCardButton:
    size_hint_x: None
    width: 96
    text: "Sync\nEnable"
    font_size: dp(12)
    image_source: "pictures/motor_gears.png"
    highlighted: bool(app.servo.servoMode)
    led_color: app.formats.color_on if app.servo.servoMode else app.formats.color_off
    # beep handled by BeepMixin.on_press
    on_release: app.servo.toggle_enable()

  # ── DIR: bordered box — "DIR" header (divider below) over a forward/
  #    reverse one-hot, matching the mockup; margin around the box ──
  BoxLayout:
    orientation: 'vertical'
    size_hint_x: None
    width: 96
    padding: dp(4), dp(6), dp(4), dp(6)
    BoxLayout:
      orientation: 'vertical'
      canvas.after:
        Color:
          rgba: app.theme.border
        Line:
          rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(7))
          width: 1.0
      Label:
        id: dir_lbl
        text: "DIR"
        size_hint_y: 0.36
        font_name: app.theme.font_bold
        font_size: self.height / 1.7
        color: app.theme.text_dim
        halign: 'center'
        valign: 'middle'
        canvas.after:
          Color:
            rgba: app.theme.border_dim
          Line:
            points: (self.x, self.y, self.right, self.y)
            width: 1.0
      TabSelector:
        orientation: "horizontal"
        shape: "bottom"
        size_hint_y: 0.64
        disabled: app.els.spindle_is_running
        selected: "fwd" if root.els_forward else "rev"
        on_select: root.els_forward = (args[1] == "fwd")
        TabSegment:
          value: "fwd"
          text: "\uf060"
          font_name: app.theme.font_icon
        TabSegment:
          value: "rev"
          text: "\uf061"
          font_name: app.theme.font_icon

  # ── ADV: shared LED card; lights cyan when advanced mode is on ──
  LedCardButton:
    size_hint_x: None
    width: 96
    text: "ADV"
    font_size: dp(20)
    highlighted: root.enable_advanced
    led_color: app.formats.color_on if root.enable_advanced else app.formats.color_off
    # beep handled by BeepMixin.on_press
    on_release: root.enable_advanced = not root.enable_advanced

  # ── Cut type / direction illustration: dark recessed panel (item 5) ──
  Button:
    background_color: 0, 0, 0, 0
    background_normal: ""
    canvas.before:
      Color:
        rgba: app.theme.recess
      RoundedRectangle:
        pos: self.x + dp(4), self.y + dp(6)
        size: self.width - dp(8), self.height - dp(12)
        radius: [dp(7)]
      Color:
        rgba: app.theme.border_dim
      Line:
        rounded_rectangle: (self.x + dp(4), self.y + dp(6), self.width - dp(8), self.height - dp(12), dp(7))
        width: 1.0
    Image:
      source: "pictures/" + root.move_type + ".png"
      x: self.parent.x + self.parent.width * 0.1
      y: self.parent.y + self.parent.height * 0.1
      width: self.parent.width * 0.8
      height: self.parent.height * 0.8
      allow_stretch: True
      keep_ratio: True

  # ── Feed / Thread: ONE bordered control. FEED/THREAD (a read-only one-hot
  #    styled like the others) + pitch open the feeds modal, which DRIVES
  #    selection; ▲▼ steppers share the box (divided), per the mockup. ──
  BoxLayout:
    orientation: 'horizontal'
    size_hint_x: None
    width: dp(178)
    padding: dp(4), dp(6), dp(4), dp(6)
    BoxLayout:
      orientation: 'horizontal'
      canvas.after:
        Color:
          rgba: app.theme.border
        Line:
          rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(7))
          width: 1.0
      # FEED/THREAD one-hot (read-only) over the pitch value; both open dialog
      BoxLayout:
        orientation: 'vertical'
        TabSelector:
          orientation: 'horizontal'
          size_hint_y: 0.42
          readonly: True
          selected: "thread" if ("Thread" in root.mode_name) else "feed"
          on_select: Factory.FeedsTablePopup().show_with_callback(root.set_feed_ratio, current_mode=root.mode_name)
          TabSegment:
            value: "feed"
            text: "FEED"
            font_name: app.theme.font_bold
            font_size: sp(13)
          TabSegment:
            value: "thread"
            text: "THREAD"
            font_name: app.theme.font_bold
            font_size: sp(13)
        Button:
          size_hint_y: 0.58
          background_color: 0, 0, 0, 0
          background_normal: ""
          text: root.feed_name + " " + ("tpi" if root.mode_name == "Thread IN" else ("in" if root.mode_name == "Feed IN" else "mm"))
          font_name: app.theme.font_mono
          font_size: min(self.height * 0.6, self.width * 0.2)
          color: app.formats.display_color
          halign: 'center'
          valign: 'middle'
          text_size: self.size
          on_press: app.beep()
          on_release: Factory.FeedsTablePopup().show_with_callback(root.set_feed_ratio, current_mode=root.mode_name)
      # vertical divider between value and steppers
      Widget:
        size_hint_x: None
        width: dp(1)
        canvas:
          Color:
            rgba: app.theme.border_dim
          Rectangle:
            pos: self.x, self.y + dp(5)
            size: dp(1), self.height - dp(10)
      # ▲▼ steppers (borderless, divided), inside the same box
      BoxLayout:
        orientation: 'vertical'
        size_hint_x: None
        width: dp(36)
        Button:
          background_color: 0, 0, 0, 0
          background_normal: ""
          font_name: app.theme.font_icon
          text: "\uf062"
          font_size: self.height * 0.36
          color: app.theme.text
          on_press: app.beep()
          on_release: root.next_feed()
        Widget:
          size_hint_y: None
          height: dp(1)
          canvas:
            Color:
              rgba: app.theme.border_dim
            Rectangle:
              pos: self.x + dp(5), self.y
              size: self.width - dp(10), dp(1)
        Button:
          background_color: 0, 0, 0, 0
          background_normal: ""
          font_name: app.theme.font_icon
          text: "\uf063"
          font_size: self.height * 0.36
          color: app.theme.text
          on_press: app.beep()
          on_release: root.previous_feed()
