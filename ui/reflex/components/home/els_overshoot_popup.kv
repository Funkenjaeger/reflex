#: import QrCode reflex.components.widgets.qr_code.QrCode

<OvershootSurveyPopup>:
    title: "Measure stop overshoot"
    size_hint_x: 0.8
    size_hint_y: None
    height: 560
    # Not auto-dismiss: a stray tap outside must not look like a choice.
    auto_dismiss: False

    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(10)

        Label:
            text: root.body_text
            halign: "left"
            valign: "top"
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
            color: app.theme.text
            font_size: app.formats.font_size

        Label:
            text: root.detail_text
            halign: "left"
            valign: "top"
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1] if root.detail_text else 0
            opacity: 1 if root.detail_text else 0
            color: app.theme.text_dim if hasattr(app.theme, "text_dim") else app.theme.text
            font_size: app.formats.font_size

        # The guide: a QR code and the address, on the prompt only. Without
        # segno the QR draws nothing and the address is still there.
        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(124) if root.state == "prompt" else 0
            opacity: 1 if root.state == "prompt" else 0
            spacing: dp(12)
            QrCode:
                data: root.guide_url if root.state == "prompt" else ""
                size_hint_x: None
                width: self.height
            Label:
                text: root.guide_text
                halign: "left"
                valign: "middle"
                text_size: self.size
                color: app.theme.text_dim if hasattr(app.theme, "text_dim") else app.theme.text
                font_size: app.formats.font_size * 0.8

        Widget:
            # spacer so the buttons sit at the bottom regardless of text length

        BoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(56)
            spacing: dp(10)

            # ── prompt: cancel / detect / sweep ─────────────────────
            FormValueButton:
                text: "Cancel"
                opacity: 1 if root.state == "prompt" else 0
                disabled: root.state != "prompt"
                size_hint_x: 1 if root.state == "prompt" else None
                width: 0 if root.state != "prompt" else 100
                on_press: app.beep()
                on_release: root.close()

            FormValueButton:
                text: "Detect"
                opacity: 1 if root.state == "prompt" else 0
                disabled: root.state != "prompt"
                size_hint_x: 1 if root.state == "prompt" else None
                width: 0 if root.state != "prompt" else 100
                on_press: app.beep()
                on_release: root.start("detect")

            FormValueButton:
                text: "Sweep"
                opacity: 1 if root.state == "prompt" else 0
                disabled: root.state != "prompt"
                size_hint_x: 1 if root.state == "prompt" else None
                width: 0 if root.state != "prompt" else 100
                on_press: app.beep()
                on_release: root.start("sweep")

            # ── running: stop measuring / close (keeps measuring) ───
            FormValueButton:
                text: "Stop measuring"
                opacity: 1 if root.state == "running" else 0
                disabled: root.state != "running"
                size_hint_x: 1 if root.state == "running" else None
                width: 0 if root.state != "running" else 100
                on_press: app.beep()
                on_release: root.stop()

            FormValueButton:
                text: "Close"
                opacity: 1 if root.state in ("running", "result") else 0
                disabled: root.state not in ("running", "result")
                size_hint_x: 1 if root.state in ("running", "result") else None
                width: 0 if root.state not in ("running", "result") else 100
                on_press: app.beep()
                on_release: root.close()

            # ── fitted: discard / save ──────────────────────────────
            FormValueButton:
                text: "Discard"
                opacity: 1 if root.state == "fitted" else 0
                disabled: root.state != "fitted"
                size_hint_x: 1 if root.state == "fitted" else None
                width: 0 if root.state != "fitted" else 100
                on_press: app.beep()
                on_release: root.stop()

            FormValueButton:
                text: "Save"
                opacity: 1 if root.state == "fitted" else 0
                disabled: root.state != "fitted"
                size_hint_x: 1 if root.state == "fitted" else None
                width: 0 if root.state != "fitted" else 100
                on_press: app.beep()
                on_release: root.save()
