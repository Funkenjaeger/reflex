# The uncommissioned options dialog. The buttons are added from Python
# (uncommissioned_details.options_for); this file only lays them out.

# The primary action. Same shape as <SetupButton>, drawn in the accent fill and
# border at rest (SetupButton's PRESSED look), so it reads as "the one to press"
# without a new colour. accent_text on accent_bg is the pair SetupButton
# already shows while pressed.
<UncommissionedPrimaryButton@Button>:
    markup: True
    font_name: app.theme.font_bold
    font_size: '21sp'
    color: app.theme.accent_text
    halign: 'center'
    valign: 'middle'
    text_size: self.width - dp(24), None
    size_hint_y: None
    height: dp(78)
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    on_press: app.beep()
    canvas.before:
        Color:
            rgba: app.theme.accent if self.state == 'down' else app.theme.accent_bg
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: app.theme.accent
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(8))
            width: 1.5

<UncommissionedOptionButton@SetupButton>:
    font_size: '19sp'
    halign: 'center'
    valign: 'middle'
    text_size: self.width - dp(24), None
    size_hint_y: None
    height: dp(58)

<UncommissionedOptions>:
    orientation: 'vertical'
    padding: dp(18), dp(10), dp(18), dp(16)
    spacing: dp(8)

    Label:
        id: lbl_headline
        text: root.headline
        font_name: app.theme.font_bold
        font_size: '21sp'
        color: app.theme.text
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]

    Label:
        id: lbl_line
        text: root.line
        font_name: app.theme.font_bold
        font_size: '17sp'
        color: app.theme.text
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1]

    # Only the restart branch has a note. Collapsed to nothing otherwise.
    Label:
        id: lbl_note
        text: root.note
        font_name: app.theme.font_bold
        font_size: '15sp'
        color: app.theme.text
        halign: 'left'
        valign: 'top'
        text_size: self.width, None
        size_hint_y: None
        height: self.texture_size[1] if root.note else 0
        opacity: 1 if root.note else 0

    Widget:
        size_hint_y: None
        height: dp(4)

    BoxLayout:
        id: options
        orientation: 'vertical'
        spacing: dp(10)
        size_hint_y: None
        height: self.minimum_height

    Widget:
