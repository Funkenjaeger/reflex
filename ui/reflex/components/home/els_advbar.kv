#: import TextHeaderButton reflex.components.toolbars.text_header_button
#: import StyledButton reflex.components.widgets.styled_button
#: import IconButton reflex.components.widgets.icon_button
#: import TabSelector reflex.components.widgets.tab_selector
#: import LedCardButton reflex.components.widgets.led_card_button
#: import StatusChip reflex.components.widgets.status_chip

<ElsAdvancedBar>:
  orientation: "vertical"
  size_hint_y: None
  # CONSTANT, and that is the point (2026-08-22). The notice strips used to
  # add their height here so the bar grew to fit them -- which meant the three
  # DRO rows above shrank 99 -> 89 px every time a warning appeared, and back
  # again when it cleared. Evan: "having things resize around a temporary
  # warning is distracting." The strips now OVERLAY the control row instead
  # (see notice_overlay below), so nothing on this screen changes size when
  # one shows up. A new strip belongs in that overlay's height expression,
  # NOT here.
  #
  # (The 99 above is the row height that rule was written against. The rows are
  # 101 px since 2026-08-29, when ElsModeLayout's dro_els_gap went dp(8) ->
  # dp(3) to even up the margins above and below the DRO stack -- a deliberate
  # one-time change to a source constant, made on Evan's explicit call, with
  # the digit size growing 87 -> 90 px as its accepted cost. It does not touch
  # the rule stated here, which is about resizing in response to TRANSIENT
  # state. See els_mode_layout._update_row_heights.)
  #
  # TRANSIENT NOTICES OVERLAY; PERSISTENT STATE DOES NOT (2026-08-29).
  # `notice_overlay` carries the strips that are up for seconds -- a take-up
  # refusal, a re-reference confirm -- pinned over the bar's top edge, because
  # covering something for three seconds is a fair trade for saying why a pass
  # was refused.
  #
  # Persistent job state used to make the same trade through a second overlay
  # (`status_overlay`), and it was the wrong one: the thread-phase offset and
  # the thread-reference latch are up for a WHOLE JOB, so whatever they covered
  # -- the "Stop Z" and "Major ø" field headers -- they covered for the whole
  # job. They now live in `status_gutter` below, a permanently reserved dp(26)
  # band carved out of this same 128 px, and cover nothing at all. The cost is
  # paid once, in the control row's height (128 -> 102 in every mode, which is
  # the height wizard mode has always run at), rather than paid in coverage
  # every time a job sets an offset.
  natural_height: 128
  # THE value of record for the status gutter's recess inset.
  # els_advbar.py's property defaults to 0 on purpose -- dp() cannot be
  # called at class-body time under the mock window; see its comment there.
  gutter_inset: dp(1)
  # Everything below hangs off ONE FloatLayout so the notice strips can be
  # pinned over the controls rather than stacked above them. A FloatLayout
  # draws later children on top, so the overlays MUST stay last.
  FloatLayout:
    id: bar_float
    size_hint: 1, 1

    # ── Content: what the bar actually is, always at full height ──────────
    BoxLayout:
      orientation: 'vertical'
      size_hint: 1, 1
      pos_hint: {'x': 0, 'y': 0}


      # ── Status gutter ──────────────────────────────────────────────────────────
      # Full-width strip across the top of the bar (over every control column) so
      # the control row below — Engage, Start, the value fields and the mode
      # selector — all share one aligned top edge.
      #
      # PERMANENT, IN EVERY MODE (2026-08-29). It began as the wizard instruction
      # strip and collapsed to nothing in stop-only and stop+retract, which is why
      # persistent job state had to be an overlay over the field headers: there was
      # no reserved space for it in the mode Evan actually runs. Reserving the
      # 26 px unconditionally buys a place to PRINT that state instead of covering
      # something with it. The container is unconditional; its CONTENTS are what
      # switch by mode -- the instruction text is still wizard-only, and each chip
      # gates itself.
      #
      # THE SPACE COMES OUT OF THE CONTROL ROW, NOT OUT OF THE BAR. natural_height
      # stays 128, so nothing above this bar resizes; the control row's
      # size_hint_y of 1 takes 102 px in every mode now instead of 128 in two of
      # them, and 102 is the height wizard mode has always used.
      #
      # THREE CHILDREN, NONE AFFECTING THE OTHERS: a FloatLayout, so the two chips
      # pin to the left and right edges and the centred label keeps the FULL width
      # to centre in. The label is deliberately NOT re-centred between the chips --
      # it would then shift sideways whenever the phase chip appeared, which is the
      # resizing-around-status this bar has spent three revisions removing.
      FloatLayout:
        id: status_gutter
        # HEIGHT, NOT A HINT OF ZERO, and this is load-bearing (2026-08-22).
        #
        # `size_hint_y: 0` does NOT set a widget's height to 0. It removes the
        # child from the box's proportional distribution while the widget keeps
        # whatever height it last had -- so in stop-only mode this strip held 26 px
        # it was no longer allocated, the control row below took the full remainder
        # (size_hint_y 1.0), and the children summed to 184 px inside a 158 px bar.
        # The 26 px of overflow pushed the notice strips clean out of the top of the
        # advanced bar and onto the spindle DRO row -- which is exactly where Evan
        # had been seeing the take-up warning, and why it looked fine in wizard
        # mode (0.2 + 0.8 leaves nothing stale) and wrong in the mode he actually
        # runs. Measured, and a forced do_layout() did NOT clear it:
        # previews/preview_takeup_banner.py.
        #
        # An explicit height keeps the box's arithmetic exact in both modes: every
        # fixed child is subtracted, and the control row's hint takes precisely
        # what is left. dp(26) matches what 0.2 of the 128 px base bar rendered as.
        #
        # UNCONDITIONAL, and that is now the load-bearing part. A gate here --
        # `dp(26) if root.enable_wizard else 0`, which is what this line used to
        # say -- puts both persistent status chips inside a zero-height container
        # in stop-only mode, i.e. renders them nowhere while the controller
        # cheerfully reports them shown. That is the 2026-08-24 invisible-latch
        # defect arriving by a new route, in the one mode the machine is run in.
        # Guarded structurally: tests/test_kv_syntax.py.
        size_hint_y: None
        height: dp(26)
        # THE INSET IS A HAIRLINE, NOT A MARGIN (2026-08-29, Evan's call). It
        # was dp(5), which left five painted-nothing pixels between the divider
        # and the top of the controls -- dead space that read as the gutter
        # floating above the control row rather than sitting on it. dp(1) puts
        # the divider on the gutter's own bottom edge, one pixel clear, so the
        # band ends AT the controls.
        #
        # `root.gutter_inset`, declared in els_advbar.py: the recess, the
        # divider and both chips' vertical centring all read the one number, so
        # the band and the things sitting in it cannot disagree. It is NOT
        # declared here as `recess_inset: dp(1)` -- kv will happily create that
        # property, but as an ObjectProperty defaulting to None, and the canvas
        # instructions below are evaluated before the rule assigns it, which
        # threw a TypeError on every frame. Rendering caught it; the kv parses
        # either way.
        canvas.before:
          # Recessed instruction strip with a hairline divider along its bottom.
          Color:
            rgba: app.theme.recess
          Rectangle:
            pos: self.x, self.y + root.gutter_inset
            size: self.width, self.height - root.gutter_inset
          Color:
            rgba: app.theme.border_dim
          Line:
            points: (self.x, self.y + root.gutter_inset + 0.5, self.right, self.y + root.gutter_inset + 0.5)
            width: 1.0

        # ── Centre slot: wizard guidance / the stop-diameter milestone ────────
        # Both centred on the gutter's FULL width and mutually exclusive in
        # practice (the depth latch is set inside a cycle, where the instruction
        # line has nothing left to say). Centring on the full width rather than
        # on the space between the chips is deliberate: see the note above.
        #
        # The container is permanent now, so this label carries the wizard gate
        # the container used to carry -- the non-wizard modes guide the operator
        # through the action-button labels and validity gating instead, and
        # printing wizard prose at them would be a new behaviour, not a
        # side-effect of reserving space.
        Label:
          id: label_instruction
          text: root.controller.instruction_text
          text_size: self.size
          size_hint: 1, 1
          pos_hint: {'x': 0, 'y': 0}
          opacity: 1 if root.enable_wizard else 0
          disabled: not root.enable_wizard
          font_name: app.theme.font_bold
          font_size: dp(15)
          color: app.theme.accent_text
          padding: dp(12), 0
          halign: 'center'
          valign: 'middle'

        # MOVED TO THE CENTRE SLOT (2026-08-29). This was a 200 px left-aligned
        # label, which is exactly where the reference chip now pins -- the two
        # would have drawn on top of each other. Full width and centred, sharing
        # the slot above; it collapses by TEXT, so an unset latch draws nothing
        # over the instruction line.
        Label:
          id: label_depth_reached
          text: "Stop ø reached" if root.controller.depth_reached else ""
          text_size: self.size
          size_hint: 1, 1
          pos_hint: {'x': 0, 'y': 0}
          font_name: app.theme.font_bold
          font_size: dp(14)
          halign: 'center'
          valign: 'middle'
          padding: dp(12), 0
          color: app.theme.success_text

        # ── Thread-reference chip: pinned LEFT, ALWAYS PRESENT ────────────────
        # It answers a question that has no other answer on this screen -- "does
        # the machine hold a phase reference?" -- and an indicator that is only
        # there when the answer is yes cannot be trusted to be there at all. So
        # both answers are printed, in the same place, in the same shape.
        #
        # THREE STATES, NOT TWO, and the third is the reason this is a chip and
        # not a lamp. In FEED mode the reference is not RELEVANT but it is still
        # LATCHED: firmware clears referenceLatched only on an elsStop.enable
        # 0->1 edge, and switching feed/thread never writes enable. The datum
        # also stays usable, because elsComputePhaseCorrection folds the error
        # mod one pitch and a single-start helix is one continuous groove. So
        # feed mode DARKENS the chip (lit: False) rather than hiding it: the
        # operator's cue is that his latched reference survives a
        # turn-feed-turn swap, and hiding the chip would say the opposite.
        #
        # No latched-Z readout, for the reason the old lamp gave: latchedZ is
        # raw Z-scale counts in the firmware's frame and nothing on the tick
        # path converts a bare count to display units. latchedSpindle is
        # meaningless to a human.
        StatusChip:
          id: chip_reference
          pos_hint: {'x': 0}
          # Centred in the RECESSED part of the gutter, not in the gutter: the
          # canvas above insets the recess by dp(5) at the bottom and draws its
          # hairline there, so centring on the full dp(26) would hang the pill's
          # bottom edge across that line.
          y: status_gutter.y + root.gutter_inset + (status_gutter.height - root.gutter_inset - self.height) / 2.0
          text: "REF LATCHED" if root.controller.thread_ref_latched else "NO REFERENCE"
          chip_color: app.theme.accent if root.controller.thread_ref_latched else app.theme.text_dim
          lit: root.controller.is_threading

        # ── Thread-phase offset chip: pinned RIGHT, only while an offset is set ─
        # A nonzero elsStop.phaseOffsetSteps means the machine is cutting at a
        # DELIBERATE phase shift and stays that way for the whole job; an
        # operator who forgets it is set ruins the next thread. Gated on the
        # controller's flag rather than on the text being non-empty, so an
        # offset that could not be CONVERTED (missing thread geometry) still
        # shows, saying so, instead of silently reading as "no offset".
        #
        # Gated by opacity, not by width or height: it is pinned to a
        # FloatLayout edge with nothing beside it, so there is no space to
        # reclaim and nothing that could move if it did.
        StatusChip:
          id: chip_phase
          pos_hint: {'right': 1}
          y: status_gutter.y + root.gutter_inset + (status_gutter.height - root.gutter_inset - self.height) / 2.0
          text: "PHASE OFFSET"
          value: root.controller.phase_offset_chip_value
          chip_color: app.theme.accent
          opacity: 1 if root.controller.phase_offset_active else 0
          disabled: not root.controller.phase_offset_active

      # ── Control row: Engage + Start/values/action + mode selector, all sharing
      #    one top/bottom edge ─────────────────────────────────────────────────
      BoxLayout:
        orientation: 'horizontal'
        # The ONLY proportional child of the bar, so it takes exactly what the
        # fixed-height siblings above it leave -- in either operator mode, with or
        # without a notice strip showing. It was 0.8/1.0 while the wizard strip
        # above was a hint; now that the strip is a real height, one hint of 1
        # keeps the arithmetic exact and removes the mixed fixed/proportional
        # sizing this bar has been laid out wrong by since 2026-08-16.
        size_hint_y: 1

        # ── Engage/Disengage: shared LED card with the tri-state ELS-stop indicator
        #    (grey Disabled / red Stopped / green Armed) integrated as the LED+text ──
        LedCardButton:
          id: card_engage
          size_hint_x: None
          width: 96
          text: "Disengage" if root.controller.engaged else "Engage"
          font_size: dp(17)
          # Also disabled while ENGAGED with sync motion armed AND the spindle
          # actually turning: "disable the stop" is ambiguous there, and
          # disengaging RELEASES the held carriage. Sync Enable stays live and is
          # the unambiguous way to stop. With the spindle STOPPED nothing can
          # move, so the button stays live even with sync armed (operator
          # decision 2026-08-17). See ui_controller.toggle_engage, which refuses
          # the same case defensively so a kv change cannot silently reopen it.
          disabled: root.is_running or (root.controller.engaged and bool(app.servo.servoMode) and app.els.spindle_is_running)
          led_on: root.controller.engaged
          led_color: app.theme.led_off if not root.controller.engaged else (app.theme.danger if root.controller.els_stop_active else app.theme.success)
          status_text: "Disabled" if not root.controller.engaged else ("Stopped" if root.controller.els_stop_active else "Armed")
          status_color: app.theme.text_dim if not root.controller.engaged else (app.theme.danger_text if root.controller.els_stop_active else app.theme.success_text)
          # beep handled by BeepMixin.on_press
          on_release: root.toggle_engage()

        # ── Start / Stop (wizard only) — facelift StyledButton: cyan for Start,
        #    red for the running Stop state ──
        StyledButton:
          id: btn_start_stop
          width: 96 if root.enable_wizard else 0
          size_hint_x: None
          margin_x: dp(4)
          margin_y: dp(6)
          # Collapse to nothing in non-wizard modes. Use `hidden` (not `opacity`) so
          # we don't add a second opacity binding that fights the class rule's
          # disabled-dim -- that conflict left a faint zero-width "Stop" ghost.
          hidden: not root.enable_wizard
          disabled: not ( root.controller.start_stop_enabled and root.enable_wizard )
          text: "Start" if root.controller.start_not_stop else "Stop"
          font_size: self.height / 4
          # Only light up (fill/border/glow) when actually enabled.
          is_highlighted: not self.disabled
          highlight_bg_color: app.theme.accent_soft if root.controller.start_not_stop else app.theme.danger_bg
          highlight_border_color: app.theme.accent if root.controller.start_not_stop else app.theme.danger
          highlight_text_color: app.theme.accent_text if root.controller.start_not_stop else app.theme.danger_text
          glow_color: app.theme.glow if root.controller.start_not_stop else app.theme.danger_glow
          on_release: root.controller.on_start_stop_button_clicked()

        Widget: # spacer

        TextHeaderButton:
          id: btn_stop_z
          text_header: "Stop Z"
          # "--" until the operator actually sets a stop Z — a never-set (0.0) stop
          # must not read like a real target (audit H1).
          text_button: app.formats.position_format.format(root.controller.stop_z) if root.controller.stop_z_valid else "--"
          blink_enable: root.controller.active_input == "stop_z"
          width: self.height
          disabled: not root.controller.x_z_inputs_enabled
          on_short_press: root.on_value_button_released("stop_z")
          on_long_press: root.on_value_long_press("stop_z")

        TextHeaderButton:
          id: btn_start_z
          text_header: "Start Z"
          # "--" until set (and after a confirm-bar Reset), like Stop Z.
          text_button: app.formats.position_format.format(root.controller.retract_z) if root.controller.retract_z_valid else "--"
          blink_enable: root.controller.active_input == "start_z"
          width: self.height if (root.enable_retract or root.enable_wizard) else 0
          opacity: 1 if (root.enable_retract or root.enable_wizard) else 0
          disabled:  not (root.controller.x_z_inputs_enabled and (root.enable_retract or root.enable_wizard) )
          on_short_press: root.on_value_button_released("start_z")
          on_long_press: root.on_value_long_press("start_z")

        Widget: # spacer

        # "Major ø" in wizard, "Safe ø" in stop + retract -- same value, named
        # for the job it is doing. Visibility and label both come from single
        # derived properties on the bar (show_start_dia / start_dia_label)
        # rather than repeating the condition on three lines here.
        TextHeaderButton:
          id: btn_major_dia
          text_header: root.start_dia_label
          # "--" until committed, like Stop Z and Start Z. 0.000 is a PERFECTLY
          # REAL diameter depending on how X was referenced, so showing it for
          # an unset field would claim a value that does not exist -- and this
          # one gates Retract, so the claim would be that the gate is armed.
          text_button: app.formats.position_format.format(root.controller.start_dia) if root.controller.start_dia_valid else "--"
          blink_enable: root.controller.active_input == "major_dia"
          width: self.height if root.show_start_dia else 0
          opacity: 1 if root.show_start_dia else 0
          disabled: not ( root.controller.x_z_inputs_enabled and root.show_start_dia )
          on_short_press: root.on_value_button_released("major_dia")
          on_long_press: root.on_value_long_press("major_dia")

        TextHeaderButton:
          id: btn_minor_dia
          text_header: "Minor ø"
          # Same reason as Major/Safe ø above: 0.000 is a real diameter, so an
          # uncommitted field must not display one.
          text_button: app.formats.position_format.format(root.controller.stop_dia) if root.controller.stop_dia_valid else "--"
          blink_enable: root.controller.active_input == "minor_dia"
          width: self.height if root.enable_wizard else 0
          opacity: 1 if root.enable_wizard else 0
          disabled: not ( root.controller.x_z_inputs_enabled and root.enable_wizard )
          on_short_press: root.on_value_button_released("minor_dia")
          on_long_press: root.on_value_long_press("minor_dia")

        Widget: # spacer

        # ── Action button (Set / Cut / Retract / Confirm). Visible in all
        # modes; non-wizard modes use it for Cut/Retract within in_cycle.
        StyledButton:
          id: btn_action
          width: self.height
          size_hint_x: None
          margin_x: dp(4)
          margin_y: dp(6)
          # When blank this reads as a recessed well (not a raised slate), per the
          # styling brief; it lights up (accent_soft fill + border) only when
          # there's an action to take.
          slate_fill: app.theme.recess
          standard_border_color: app.theme.border_dim
          is_highlighted: bool(root.controller.action_button_text) and root.controller.action_allowed
          disabled: not root.controller.action_button_text or not root.controller.action_allowed
          text: root.controller.action_button_text
          font_size: self.height / 4
          on_release: root.controller.on_action_button_clicked()

        # ── Mode selector + settings ───────────────────────────────────────────
        BoxLayout:
          id: mode_column
          orientation: "vertical"
          size_hint_x: None
          # Fixed width (independent of the wizard-collapsed row height) so the mode
          # tabs stay a consistent size; left padding keeps a margin from the action
          # button to their left. The tri-state tab takes the larger share; the
          # settings cog sits below it.
          width: dp(100)
          padding: dp(12), dp(6), 0, dp(6)
          spacing: 4

          # One-hot tri-state operating-mode tab: shows all three states with
          # the active one highlighted, like the sidebar tabs but horizontal
          # (matching this button's aspect). Tap anywhere cycles wizard →
          # stop+retract → stop. Wizard is the wand glyph; the stop modes use
          # the stop-sign / U-arrow SVG icons (stacked when both are shown).
          TabSelector:
            id: btn_mode
            size_hint_y: 0.62
            orientation: "horizontal"
            shape: "standalone"
            # Sit the one-hot in a recessed well (inset by padding so the carved
            # frame shows around the segments).
            padding: dp(3)
            canvas.before:
              Color:
                rgba: app.theme.recess
              RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(7)]
              Color:
                rgba: 1, 1, 1, 1
              Rectangle:
                texture: app.theme.recess_shadow
                pos: self.x + dp(4), self.top - 1 - dp(6)
                size: max(self.width - dp(8), 0), dp(6)
              Color:
                rgba: app.theme.border_dim
              Line:
                rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(7))
                width: 1.0
            disabled: root.is_running
            selected: root.mode
            on_select: root.apply_mode(args[1])
            TabSegment:
              value: "wizard"
              text: ""
              font_name: app.theme.font_icon
              font_size: min(self.height * 0.6, self.width * 0.52)
            TabSegment:
              value: "stop_retract"
              icons: ["pictures/stop_retract.png"]
            TabSegment:
              value: "stop"
              icons: ["pictures/stop_sign.png"]

          IconButton:
            id: btn_settings
            size_hint_y: 0.38
            icon: ""
            disabled: root.is_running
            on_release: root.open_settings()


    # ── Notice overlay: pinned to the bar's TOP edge, hovering over the
    #    controls. Its strips already draw a translucent tint, so the control
    #    row stays visible underneath -- and, more importantly, stays exactly
    #    where it was. Height is the sum of whatever strips are showing; a
    #    strip missing from this expression will render outside the overlay,
    #    which is the 2026-08-16 defect one level down. LAST child on purpose:
    #    FloatLayout paints in declaration order.
    #
    #    ONE STRIP IS ONE GUTTER (2026-08-29, Evan's call). The strips were
    #    dp(30) each, a literal chosen before the status gutter existed, and
    #    the gutter's painted band is 25 px -- so a warning spilled 9 px past
    #    the divider and down over the top of the controls. Measured off the
    #    render: red fill to image row 373 against a gutter ending at 369.
    #    Deriving the height from `status_gutter.height` instead of restating a
    #    number is the whole fix: a literal here and a literal there is exactly
    #    how the two drifted apart, and the gutter can now be resized without
    #    anyone remembering this file has a second copy of its height.
    #
    #    STILL A SUM, because the guard above it is right: two notices up at
    #    once must raise the overlay by both, and a strip missing from this
    #    expression renders outside it. Two at once is therefore two gutters
    #    tall and does still reach past the gutter -- unchanged from before
    #    and not what Evan flagged, but it is not covered by this fix.
    BoxLayout:
      id: notice_overlay
      orientation: 'vertical'
      size_hint_x: 1
      size_hint_y: None
      height: (status_gutter.height if (root.controller.reframe_confirm_pending or root.controller.targets_reframed_warn) else 0) + (status_gutter.height if root.controller.takeup_warning else 0)
      pos_hint: {'x': 0, 'top': 1}


      # ── Re-reference notice strip (audit H1 follow-up) ─────────────────────────
      # Shown when a committed Stop/Start value was re-referenced by a DRO re-zero /
      # coordinate change (the physical target is unchanged). 'warn' → message only;
      # 'confirm' → Keep/Reset. Collapses to zero height when there's no notice.
      # NOTE: needs an on-device look — colors/spacing are a first pass.
      BoxLayout:
        id: reframe_notice
        orientation: 'horizontal'
        size_hint_y: None
        spacing: dp(8)
        padding: dp(8), 0
        height: status_gutter.height if (root.controller.reframe_confirm_pending or root.controller.targets_reframed_warn) else 0
        opacity: 1 if self.height else 0
        disabled: not self.height
        canvas.before:
          Color:
            rgba: (1, 0.72, 0.16, 0.28)
          Rectangle:
            pos: self.pos
            size: self.size
        Label:
          text: root.controller.reframe_message
          text_size: self.size
          halign: 'left'
          valign: 'middle'
          font_name: app.theme.font_bold
          font_size: dp(13)
          color: app.theme.text
        StyledButton:
          text: "Keep"
          size_hint_x: None
          width: dp(64) if root.controller.reframe_confirm_pending else 0
          opacity: 1 if root.controller.reframe_confirm_pending else 0
          disabled: not root.controller.reframe_confirm_pending
          on_release: root.controller.clear_reframe_notice()
        StyledButton:
          text: "Reset"
          size_hint_x: None
          width: dp(64) if root.controller.reframe_confirm_pending else 0
          opacity: 1 if root.controller.reframe_confirm_pending else 0
          disabled: not root.controller.reframe_confirm_pending
          on_release: root.controller.reset_reframed_targets()

      # ── Take-up refusal notice ────────────────────────────────────────────────
      #    Shown when the firmware refused to start a pass because it could not
      #    confirm the backlash take-up actually moved the carriage. The pass is
      #    aborted back to the stopped state with the thread phase reference
      #    intact, so the operator just closes the half-nut and presses Cut again;
      #    this strip is the ONLY thing that tells them why nothing happened.
      #    Collapses to zero height when there is nothing to say.
      BoxLayout:
        id: takeup_notice
        orientation: 'horizontal'
        size_hint_y: None
        spacing: dp(8)
        padding: dp(8), 0
        height: status_gutter.height if root.controller.takeup_warning else 0
        opacity: 1 if self.height else 0
        disabled: not self.height
        canvas.before:
          Color:
            rgba: (0.85, 0.16, 0.16, 0.30)
          Rectangle:
            pos: self.pos
            size: self.size
        Label:
          text: root.controller.takeup_warning
          text_size: self.size
          halign: 'center'
          valign: 'middle'
          font_name: app.theme.font_bold
          font_size: dp(13)
          color: app.theme.text
