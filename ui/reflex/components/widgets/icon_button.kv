# Styling for IconButton (see icon_button.py). Mirrors StyledButton's slate /
# cyan-glow looks but sized for a square glyph button.

#: import THEME reflex.components.widgets.facelift_theme

<IconButton>:
    opacity: 0.4 if self.disabled else 1

    canvas.before:
        # Soft outer glow (highlighted only).
        Color:
            rgba: THEME.GLOW if root.is_highlighted else [0, 0, 0, 0]
        RoundedRectangle:
            pos: (self.x - 3, self.y - 3)
            size: (self.width + 6, self.height + 6)
            radius: [root.radius + 3]

        # Body fill.
        Color:
            rgba: THEME.ACCENT_BG if root.is_highlighted else THEME.SLATE_FILL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [root.radius]

        # Border.
        Color:
            rgba: THEME.ACCENT if root.is_highlighted else THEME.BORDER
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, root.radius)
            width: 1.5 if root.is_highlighted else 1.0

    Label:
        text: root.icon
        font_name: root.font_name
        font_size: root.font_size if root.font_size else min(self.height, self.width) * 0.42
        color: (root.icon_color if root.icon_color[3] > 0 else (THEME.ACCENT_TEXT if root.is_highlighted else THEME.TEXT))
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}
        text_size: self.size
        halign: 'center'
        valign: 'middle'
