# ── Popup chrome ───────────────────────────────────────────────────────────
# Restyle every stock Kivy Popup into the facelift look: dark-steel frame,
# cyan Chakra-Petch title, and a crisp cyan separator under it.
<Popup>:
    title_color: app.theme.accent_text
    title_font: app.theme.font_bold
    title_size: '18sp'
    separator_color: app.theme.accent
    separator_height: dp(2)
    background: ''
    background_color: 0, 0, 0, 0
    canvas.before:
        Color:
            rgba: app.theme.border
        RoundedRectangle:
            pos: self.x - dp(1), self.y - dp(1)
            size: self.width + dp(2), self.height + dp(2)
            radius: [dp(9)]
        Color:
            rgba: app.theme.background
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]

# ── Shared settings-row controls ───────────────────────────────────────────
# DISABLED COLOURS ARE THEMED HERE TOO, NOT JUST `color`. Kivy draws a disabled
# Label/Button in `disabled_color` and a disabled TextInput in
# `disabled_foreground_color`, and their stock values -- white at 30% and BLACK
# AT 50% -- know nothing about the theme. Black-at-50% on the dark `recess`
# fill measured 1.02:1, which is why every read-only value on Setup > System
# was invisible in the dark theme (reported at the lathe 2026-09-19; the stock
# fallbacks had been live since these controls were introduced in 02def60).
# Any colour property added to these rules needs its disabled twin as well;
# tests/test_form_disabled_colors.py holds that, and
# previews/preview_setup_contrast.py measures the pixels.
# Subtle info/help button (the "i" icon at the left of each settings row).
<FormHelpButton@ButtonBehavior+FloatLayout>:
    # Circle-question help affordance (Font Awesome "circle-question", \uf059).
    # The glyph lives in a CHILD Label whose font is set here in the parent rule,
    # so it applies after -- and wins over -- the global <Label>/<Button> font
    # rules in home_screen.kv (which force iosevka/Manrope and would otherwise
    # clobber the icon font and render the glyph as tofu). Same pattern as
    # IconButton; a dynamic class based directly on Label/Button loses that race.
    size_hint_x: None
    width: self.height
    # Enabled icon in `text`: text_dim on the page background is 3.96:1 in
    # dark but 2.02-2.25:1 in light (2026-09-19), and an enabled help icon
    # is a control, so it gets the same floor as text.
    #
    # A row with NO help topic shows NO icon (Evan, 2026-09-19). Kivy's stock
    # disabled fade measured 2.63:1 dark and 1.10-1.15:1 light -- a control
    # that cannot be used, drawn just visibly enough to invite a tap. The row
    # keeps the icon's width, so captions stay aligned down the column.
    opacity: 0 if self.disabled else 1
    Label:
        text: "\uf059"
        font_name: app.theme.font_icon
        font_size: dp(19)
        color: app.theme.text
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}
        halign: 'center'
        valign: 'middle'
        text_size: self.size

# Row caption: left-aligned, Chakra Petch, light blue-grey.
<FormLabel@Label>:
    color: app.theme.text
    disabled_color: app.theme.text_disabled
    font_name: app.theme.font_bold
    font_size: app.formats.font_size
    halign: 'left'
    valign: 'middle'
    text_size: self.size
    padding: dp(16), 0

# Themed value control on the right side of a settings row (a recessed slate
# pill with a border; cyan-tinted while pressed/active).
<FormValueButton@Button>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    font_name: app.theme.font_bold
    font_size: app.formats.font_size
    color: app.theme.accent_text
    disabled_color: app.theme.text_disabled
    canvas.before:
        Color:
            rgba: app.theme.accent_bg if self.state == 'down' else app.theme.surface
        RoundedRectangle:
            pos: self.x + dp(4), self.y + dp(5)
            size: self.width - dp(8), self.height - dp(10)
            radius: [dp(5)]
        Color:
            rgba: app.theme.accent if self.state == 'down' else app.theme.border
        Line:
            rounded_rectangle: (self.x + dp(4) + 0.5, self.y + dp(5) + 0.5, self.width - dp(8) - 1, self.height - dp(10) - 1, dp(5))
            width: 1.0

# ON/OFF toggle: green-cyan accent fill when on, quiet slate when off.
# OFF is drawn in `text`, not `text_dim`: text_dim on the `surface` pill
# measured 2.38:1 dark / 2.82:1 light (Setup > Formats/Network/Servo/Update,
# 2026-09-19) -- the word OFF was the least legible thing on those screens.
# ON vs OFF stays distinct through the fill (accent_bg vs surface), the
# border (accent vs border) and the ink (accent_text vs text), not through
# making OFF hard to read.
<FormToggle@ToggleButton>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    font_name: app.theme.font_bold
    font_size: app.formats.font_size
    color: app.theme.accent_text if self.state == 'down' else app.theme.text
    disabled_color: app.theme.text_disabled
    canvas.before:
        Color:
            rgba: app.theme.accent_bg if self.state == 'down' else app.theme.surface
        RoundedRectangle:
            pos: self.x + dp(4), self.y + dp(5)
            size: self.width - dp(8), self.height - dp(10)
            radius: [dp(5)]
        Color:
            rgba: app.theme.accent if self.state == 'down' else app.theme.border
        Line:
            rounded_rectangle: (self.x + dp(4) + 0.5, self.y + dp(5) + 0.5, self.width - dp(8) - 1, self.height - dp(10) - 1, dp(5))
            width: 1.0

# Themed action button: the Setup menu grid, Backup's actions, Update's
# Install/Exit, the Logs and Inputs/Axes lists. Lived in setup_screen.kv until
# 2026-09-19; moved here, where it is loaded once for the whole app, so any
# screen (or Python code, via Factory.SetupButton) can use it without importing
# setup_screen first.
# Disabled text is `text_disabled`, NOT the enabled colour at 35% alpha: alpha
# dimming pulls the ink toward the fill and measured 2.07:1 dark / 1.98:1 light
# on Backup's disabled gist buttons (2026-09-19). text_disabled is tuned for
# >= 3:1 on `surface` in every theme (tests/components/test_theme_contrast.py).
<SetupButton@Button>:
    font_name: app.theme.font_bold
    font_size: app.formats.font_size
    color: app.theme.accent_text if self.state == 'down' else app.theme.text
    disabled_color: app.theme.text_disabled
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_disabled_down: ''
    background_color: 0, 0, 0, 0
    on_press: app.beep()
    canvas.before:
        Color:
            rgba: app.theme.accent_bg if self.state == 'down' else app.theme.surface
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(8)]
        Color:
            rgba: app.theme.accent if self.state == 'down' else app.theme.border
        Line:
            rounded_rectangle: (self.x + 0.5, self.y + 0.5, self.width - 1, self.height - 1, dp(8))
            width: 1.0

# Themed single-line text entry for string settings.
<FormTextInput@TextInput>:
    background_normal: ''
    background_active: ''
    # Without this a disabled field swaps to Kivy's stock textinput_disabled
    # image (tinted by background_color), a different-looking well.
    background_disabled_normal: ''
    background_color: app.theme.recess
    foreground_color: app.theme.text
    disabled_foreground_color: app.theme.text_disabled
    cursor_color: app.theme.accent
    font_name: app.theme.font_bold
    padding: [dp(12), (self.height - self.line_height) / 2 if self.height > self.line_height else dp(6)]

# Read-only, multi-line output box (System "Operation Output", Network
# "Status", Update "Update Status"). These were stock TextInputs: white well,
# black text, whatever the theme. Same themed well as FormTextInput, but a
# rule of its own rather than <FormOutputText@FormTextInput>: FormTextInput's
# padding is an expression on height (it centres ONE line), and a subclass
# rule's plain padding does not stop that expression re-firing, so output
# text ended up floating mid-box. Monospace for log text.
<FormOutputText@TextInput>:
    readonly: True
    multiline: True
    background_normal: ''
    background_active: ''
    background_disabled_normal: ''
    background_color: app.theme.recess
    foreground_color: app.theme.text
    disabled_foreground_color: app.theme.text_disabled
    cursor_color: app.theme.accent
    font_name: app.theme.font_mono
    padding: [dp(12), dp(8)]

# Plain themed text for a Setup screen: what a bare `Label:` should have been.
# A stock Label draws white whatever the theme -- 1.38-1.52:1 on the light
# page (Formats volume, Logs heading, Profiling stats, 2026-09-19).
# tests/components/test_setup_screens_themed.py keeps stock Label/Button/
# TextInput off the Setup screens unless they are given a themed colour.
<ThemedLabel@Label>:
    color: app.theme.text
    disabled_color: app.theme.text_disabled

# ── Feeds selector (TabbedPanel + grid of FeedButton) ──────────────────────
# Only the feed/thread picker uses TabbedPanel, so theming these globally is
# safe and keeps the picker consistent with the rest of the facelift.
<TabbedPanel>:
    # background_image MUST be cleared, not just tinted: Kivy's default is an
    # atlas bitmap that is dark whatever background_color says, so in the light
    # theme the picker's body stayed near-black and its "Select Feed" title --
    # accent_text, meant for a light panel -- measured 1.14:1 on it.
    background_image: ''
    background_color: app.theme.background
    border: [0, 0, 0, 0]

<TabbedPanelContent>:
    # Same story as TabbedPanel above: the content area carries its own stock
    # dark bitmap, which is what the picker's body actually showed.
    canvas.before:
        Color:
            rgba: app.theme.background
        Rectangle:
            pos: self.pos
            size: self.size

<TabbedPanelStrip>:
    canvas.before:
        Color:
            rgba: app.theme.recess
        Rectangle:
            pos: self.pos
            size: self.size

<TabbedPanelHeader>:
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_disabled_down: ''
    background_color: 0, 0, 0, 0
    font_name: app.theme.font_bold
    color: app.theme.accent_text if self.state == 'down' else app.theme.text_dim
    canvas.before:
        Color:
            rgba: app.theme.accent_bg if self.state == 'down' else app.theme.surface
        Rectangle:
            pos: self.x + dp(2), self.y + dp(2)
            size: self.width - dp(4), self.height - dp(4)
        Color:
            rgba: app.theme.accent if self.state == 'down' else [0, 0, 0, 0]
        Rectangle:
            pos: self.x + dp(2), self.y + dp(2)
            size: self.width - dp(4), dp(2)

# Feed/pitch value tile in the picker grid.
<FeedButton>:
    background_normal: ''
    background_down: ''
    background_color: 0, 0, 0, 0
    color: app.theme.accent_text if self.state == 'down' else app.theme.text
    font_name: app.theme.font_bold
    canvas.before:
        Color:
            rgba: app.theme.accent_bg if self.state == 'down' else app.theme.surface
        RoundedRectangle:
            pos: self.x + dp(3), self.y + dp(3)
            size: self.width - dp(6), self.height - dp(6)
            radius: [dp(5)]
        Color:
            rgba: app.theme.accent if self.state == 'down' else app.theme.border
        Line:
            rounded_rectangle: (self.x + dp(3) + 0.5, self.y + dp(3) + 0.5, self.width - dp(6) - 1, self.height - dp(6) - 1, dp(5))
            width: 1.0
