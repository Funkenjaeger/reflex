# Styling for TabSelector / TabSegment (see tab_selector.py).
#
# Each segment paints its OWN rounded background, so selected and unselected
# segments share identical geometry -- no separate group "backing" layer to
# peek out from under a square selected fill (which caused the corner notch +
# square-selected-corner artifacts). The outer (screen-side) corner is rounded
# only on the first/last segment so the butted group reads as one rounded-left
# strip. The inner edge stays flush and carries a crisp cyan accent bar when
# selected (no soft glow -> no ghosting/misalignment).

#: import THEME reflex.components.widgets.facelift_theme

<TabSelector>:
    spacing: 0


<TabSegment>:
    opacity: 0.45 if self.disabled else 1

    canvas.before:
        # Per-segment body fill. Round only the outer corner of the first/last
        # segment: left corners for a right-accent group, right corners for a
        # left-accent group, none for horizontal groups.
        Color:
            rgba: THEME.ACCENT_BG if self.is_selected else THEME.SLATE_FILL
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [(dp(7) if self.is_first else 0), 0, 0, (dp(7) if self.is_last else 0)] if self.edge == 'right' else ([0, (dp(7) if self.is_first else 0), (dp(7) if self.is_last else 0), 0] if self.edge == 'left' else [0, 0, 0, 0])

        # Hairline divider between stacked segments (skip the first).
        Color:
            rgba: THEME.BORDER_DIM if not self.is_first else [0, 0, 0, 0]
        Line:
            points: (self.x, self.top, self.right, self.top)
            width: 1.0

        # Crisp accent bar on the inner edge when selected.
        Color:
            rgba: THEME.ACCENT if self.is_selected else [0, 0, 0, 0]
        Rectangle:
            pos: (self.x, self.y) if self.edge == 'left' else ((self.right - dp(3), self.y) if self.edge == 'right' else ((self.x, self.y) if self.edge == 'bottom' else (self.x, self.top - dp(3))))
            size: (dp(3), self.height) if self.edge in ('left', 'right') else (self.width, dp(3))

    Label:
        text: root.text
        font_name: root.font_name
        font_size: root.font_size if root.font_size else min(self.height * 0.62, sp(24))
        bold: True
        color: THEME.ACCENT_TEXT if root.is_selected else THEME.TEXT_DIM
        size_hint: 1, 1
        pos_hint: {'x': 0, 'y': 0}
        text_size: self.size
        halign: 'center'
        valign: 'middle'
