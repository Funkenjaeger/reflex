<ProfilingPanel>:
  orientation: "vertical"
  spacing: 5

  # FPS Stats Row
  BoxLayout:
    size_hint_y: None
    height: 48
    spacing: 10
    Label:
      text: f"FPS: {root.fps_current:.1f}"
      font_size: 20
      bold: True
      color: app.theme.success if root.fps_current > 25 else (app.theme.warning if root.fps_current > 10 else app.theme.danger)
    ThemedLabel:
      text: f"Min: {root.fps_min:.1f}"
      font_size: 18
    ThemedLabel:
      text: f"Max: {root.fps_max:.1f}"
      font_size: 18
    ThemedLabel:
      text: f"Avg: {root.fps_avg:.1f}"
      font_size: 18

  # Frame time row
  BoxLayout:
    size_hint_y: None
    height: 48
    spacing: 10
    ThemedLabel:
      text: f"Frame: {root.frame_time_ms:.1f}ms"
      font_size: 18
    Label:
      text: f"Max frame: {root.frame_time_max_ms:.1f}ms"
      font_size: 18
      color: app.theme.danger if root.frame_time_max_ms > 50 else app.theme.text
    Widget:
    Widget:

  # Controls row
  BoxLayout:
    size_hint_y: None
    height: 60
    spacing: 10
    padding: 0, 5
    # SetupButtons (they beep on press themselves). Start/Stop keeps its
    # green/red meaning in the ink rather than a tint of Kivy's stock grey.
    SetupButton:
      text: "Stop Profiling" if root.is_profiling else "Start Profiling"
      font_size: 22
      color: app.theme.danger_text if root.is_profiling else app.theme.success_text
      on_release: root.toggle_profiling()
    SetupButton:
      text: "Reset Stats"
      font_size: 22
      on_release: root.reset_stats()

  # Status
  ThemedLabel:
    text: root.status_text
    size_hint_y: None
    height: 30
    font_size: 16
    halign: "left"
    text_size: self.size
    valign: "middle"

  # Profile results
  ScrollView:
    do_scroll_x: True
    do_scroll_y: True
    ThemedLabel:
      text: root.profile_results
      size_hint: None, None
      width: max(self.texture_size[0] + 20, self.parent.width) if self.parent else self.texture_size[0] + 20
      height: self.texture_size[1] + 20
      text_size: None, None
      padding: 10, 10
      font_size: 13
      font_name: "fonts/iosevka-regular.ttf"
      halign: "left"
      valign: "top"